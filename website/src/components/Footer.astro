---
import Default from '@astrojs/starlight/components/Footer.astro';

const release = __DOCS_RELEASE__;
const revision = __DOCS_REVISION__;
const channel = __DOCS_CHANNEL__;
const repository = 'https://github.com/metaneutrons/ami-rust';
const short = revision.slice(0, 7);
---

<Default {...Astro.props}><slot /></Default>
<p class="build-stamp">
  {channel === 'next' ? (
    <>Development documentation, built from <a href={`${repository}/commit/${revision}`}><code>{short}</code></a> on the <code>main</code> branch.
    The latest release is <a href={`${repository}/releases/tag/v${release}`}><code>v{release}</code></a>.</>
  ) : (
    <>Documentation for ami-rust {release}, built from <a href={`${repository}/commit/${revision}`}><code>{short}</code></a>.
    The released source is tag <a href={`${repository}/releases/tag/v${release}`}><code>v{release}</code></a>.</>
  )}
  See <a href="/releases/">Releases and versions</a>.
</p>
