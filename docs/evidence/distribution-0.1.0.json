  "criteria": [
    {
      "id": "D0-A1",
      "status": "PASS",
      "evidence": "One adapter reuses the original pinned SDK verifier, provisioner, installer, project generator/lock and build driver; package and user state ownership remain separate."
    },
    {
      "id": "D0-A2",
      "status": "PASS",
      "evidence": "Twelve sealed files retain complete inventories, protected-source provenance, signatures, upstream licences and byte mapping to the six accepted SDK assets. Real cryptographic corruption probes and wrong-host/input/version fixtures reject."
    },
    {
      "id": "D0-A3",
      "status": "PASS",
      "evidence": "Both actual package managers pass install, preparation, locked offline build, local lower-revision upgrade, remove and reinstall. Public clients rebuild retained projects after removal and preserve global Rust settings."
    },
    {
      "id": "D0-A4",
      "status": "PASS",
      "evidence": "Existing R1 installer recovery remains unchanged. Adapter integrity/ownership and failed-state fixtures reject safely; fresh-state retries and actual retained-launcher rebuild after package removal pass. Only campaign-owned package state is cleaned."
    },
    {
      "id": "D0-A5",
      "status": "PASS",
      "evidence": "Published package sizes, scoped filesystem inventories, original preparation receipts and command RSS/work measurements, observed volume-space deltas and cold/warm timings are retained; all named campaigns close within their prospective limits."
    },
    {
      "id": "APT-A1",
      "status": "PASS",
      "evidence": "Canonical amd64 Debian control/layout, dependencies, modes, inventory and SPDX mapping pass; the exact public DEB has protected producer provenance and signatures."
    },
    {
      "id": "APT-A2",
      "status": "PASS",
      "evidence": "A fresh Ubuntu 24.04 amd64 client executes the documented dedicated-keyring/deb822 setup and install, then prepares/builds and reproduces the accepted R1 native SHA. Signature, strongest SHA512 by-hash and exact pool payload checks pass; altered signature/index/payload/key/time cases reject."
    },
    {
      "id": "APT-A3",
      "status": "PASS",
      "evidence": "The public client installs an explicitly local unsigned lower-revision fixture, upgrades through the signed archive to ami-rust=0.1.0-2 and replays the project. Package removal and separate source/keyring removal execute as documented. Existing archive transaction safeguards and post-publication verification remain in force."
    },
    {
      "id": "BREW-A1",
      "status": "PASS",
      "evidence": "The exact attested formula passes protected tap syntax/style/audit, install and meaningful brew test on macOS 26 Apple Silicon; unsupported hosts reject."
    },
    {
      "id": "BREW-A2",
      "status": "PASS",
      "evidence": "The actual macOS lifecycle passes install, prepare/build, reinstall, upgrade, removal, retained-state replay and owned-keg/tap cleanup, including the real retained-two-keg inventory. Auto-pruned and foreign inventory cases are covered by regression tests."
    },
    {
      "id": "BREW-A3",
      "status": "PASS",
      "evidence": "A narrowly scoped GitHub App opens the exact formula/README PR, required CI passes before merge, public formula bytes match the attested file, and a fresh public-tap client installs/tests/builds successfully."
    }
  ],
