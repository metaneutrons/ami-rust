diff --git a/library/std/src/sys/alloc/aros.rs b/library/std/src/sys/alloc/aros.rs
new file mode 100644
index 0000000..f83b37b
--- /dev/null
+++ b/library/std/src/sys/alloc/aros.rs
@@ -0,0 +1,78 @@
+use super::{MIN_ALIGN, realloc_fallback};
+use crate::alloc::Layout;
+use crate::ptr;
+
+mod c {
+    use core::ffi::{c_int, c_size_t, c_void};
+
+    unsafe extern "C" {
+        #[rustc_canonical_symbol]
+        pub fn malloc(size: c_size_t) -> *mut c_void;
+
+        pub fn calloc(count: c_size_t, size: c_size_t) -> *mut c_void;
+
+        #[rustc_canonical_symbol]
+        pub fn realloc(ptr: *mut c_void, size: c_size_t) -> *mut c_void;
+
+        #[rustc_canonical_symbol]
+        pub fn free(ptr: *mut c_void);
+
+        pub fn posix_memalign(out: *mut *mut c_void, align: c_size_t, size: c_size_t) -> c_int;
+    }
+}
+
+// The Exec allocator under `malloc` does not refuse huge requests reliably: on
+// ABI1 a request of 2^37 bytes corrupts the TLSF free lists and on ABI11 sizes
+// from 2^38 bytes return a small block. Larger requests are refused here.
+const MAX_REQUEST: usize = 1 << 32;
+
+// The AROS C library allocates from an Exec pool with a 16 byte header, so
+// `malloc` returns blocks aligned to `MIN_ALIGN`. Larger alignments go through
+// `posix_memalign`, whose blocks `free` accepts but `realloc` does not.
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    if layout.size() > MAX_REQUEST {
+        return ptr::null_mut();
+    }
+    if layout.align() <= MIN_ALIGN && layout.align() <= layout.size() {
+        unsafe { c::malloc(layout.size()) as *mut u8 }
+    } else {
+        let mut out = ptr::null_mut();
+        let align = layout.align().max(size_of::<usize>());
+        let ret = unsafe { c::posix_memalign(&mut out, align, layout.size()) };
+        if ret != 0 { ptr::null_mut() } else { out as *mut u8 }
+    }
+}
+
+#[inline]
+pub unsafe fn alloc_zeroed(layout: Layout) -> *mut u8 {
+    if layout.size() > MAX_REQUEST {
+        return ptr::null_mut();
+    }
+    if layout.align() <= MIN_ALIGN && layout.align() <= layout.size() {
+        unsafe { c::calloc(layout.size(), 1) as *mut u8 }
+    } else {
+        let ptr = unsafe { alloc(layout) };
+        if !ptr.is_null() {
+            unsafe { ptr::write_bytes(ptr, 0, layout.size()) };
+        }
+        ptr
+    }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, _layout: Layout) {
+    unsafe { c::free(ptr as *mut core::ffi::c_void) }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+    if new_size > MAX_REQUEST {
+        return ptr::null_mut();
+    }
+    if layout.align() <= MIN_ALIGN && layout.align() <= new_size {
+        unsafe { c::realloc(ptr as *mut core::ffi::c_void, new_size) as *mut u8 }
+    } else {
+        unsafe { realloc_fallback(ptr, layout, new_size) }
+    }
+}
