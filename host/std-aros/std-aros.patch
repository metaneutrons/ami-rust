diff --git a/library/std/src/sys/random/aros.rs b/library/std/src/sys/random/aros.rs
new file mode 100644
index 0000000..9ad499e
--- /dev/null
+++ b/library/std/src/sys/random/aros.rs
@@ -0,0 +1,54 @@
+//! Weak entropy for `HashMap` seeding. The AROS C library has no `getrandom`
+//! or `getentropy`, so the generator mixes the clocks and two addresses. It is
+//! not suitable for cryptography.
+
+use crate::ffi::c_int;
+use crate::sync::atomic::{AtomicU64, Ordering};
+
+// `time_t` is a 32-bit integer in the AROS C library and `long` is 64-bit.
+#[repr(C)]
+struct Timespec {
+    tv_sec: i32,
+    tv_nsec: i64,
+}
+
+// AROS numbers its clocks differently from POSIX systems.
+const CLOCK_MONOTONIC: c_int = 0;
+const CLOCK_REALTIME: c_int = 2;
+
+unsafe extern "C" {
+    fn clock_gettime(clock: c_int, tp: *mut Timespec) -> c_int;
+}
+
+static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+fn clock_bits(clock: c_int) -> u64 {
+    let mut tp = Timespec { tv_sec: 0, tv_nsec: 0 };
+    if unsafe { clock_gettime(clock, &mut tp) } == 0 {
+        ((tp.tv_sec as u32 as u64) << 32) ^ tp.tv_nsec as u64
+    } else {
+        0
+    }
+}
+
+fn splitmix64(state: &mut u64) -> u64 {
+    *state = state.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    let mut z = *state;
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    z ^ (z >> 31)
+}
+
+pub fn fill_bytes(bytes: &mut [u8]) {
+    let stack = 0u8;
+    let heap = Box::new(0u8);
+    let mut state = clock_bits(CLOCK_MONOTONIC)
+        ^ clock_bits(CLOCK_REALTIME).rotate_left(21)
+        ^ (&raw const stack).addr() as u64
+        ^ ((&raw const *heap).addr() as u64).rotate_left(42)
+        ^ COUNTER.fetch_add(0x2545_f491_4f6c_dd1d, Ordering::Relaxed);
+    for chunk in bytes.chunks_mut(8) {
+        let word = splitmix64(&mut state).to_ne_bytes();
+        chunk.copy_from_slice(&word[..chunk.len()]);
+    }
+}
