+        // SAFETY: `path` is a valid C string.
+        let stream = without_requesters(|| unsafe { c::opendir(path.as_ptr()) });
+        if stream.is_null() {
+            return Err(last_error());
+        }
+        Ok(ReadDir {
+            inner: Arc::new(InnerReadDir { stream: DirStream(stream), root: p.to_path_buf() }),
+            end_of_stream: false,
