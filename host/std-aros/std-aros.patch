+/// The `open` flags of the AROS C library. They differ from Linux, and are the same in both
+/// SDKs for the ones used here.
+mod flag {
+    use crate::ffi::c_int;
+    pub const O_RDONLY: c_int = 0x0001;
+    pub const O_WRONLY: c_int = 0x0002;
+    pub const O_RDWR: c_int = O_RDONLY | O_WRONLY;
+    pub const O_CREAT: c_int = 0x0040;
+    pub const O_EXCL: c_int = 0x0080;
+    pub const O_TRUNC: c_int = 0x0200;
+    pub const O_APPEND: c_int = 0x0400;
+}
+
+const SEEK_SET: c_int = 0;
+const SEEK_CUR: c_int = 1;
+const SEEK_END: c_int = 2;
+
+/// `EINVAL` and `EBADF` in the numbering of the AROS C library (NetBSD's).
+const EINVAL: i32 = 22;
+const EBADF: i32 = 9;
+/// `ENOENT`, `EBUSY`, `ENOTDIR`, `EISDIR` and `ENOTEMPTY` in the same numbering.
+const ENOENT: i32 = 2;
+const ENOTEMPTY: i32 = 66;
+const EXDEV: i32 = 18;
+const EBUSY: i32 = 16;
+const ENOTDIR: i32 = 20;
+const EISDIR: i32 = 21;
+
+/// DOS takes a signed 32-bit length, so one call never moves more than this.
+const IO_LIMIT: usize = 1 << 30;
+
+mod c {
+    use crate::ffi::{c_char, c_int, c_void};
+
+    unsafe extern "C" {
+        pub fn open(path: *const c_char, flags: c_int, ...) -> c_int;
+        pub fn close(fd: c_int) -> c_int;
+        pub fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;
+        pub fn write(fd: c_int, buf: *const c_void, count: usize) -> isize;
+        pub fn lseek(fd: c_int, offset: i64, whence: c_int) -> i64;
+        pub fn ftruncate(fd: c_int, length: i64) -> c_int;
+        pub fn fsync(fd: c_int) -> c_int;
+        pub fn dup(fd: c_int) -> c_int;
+        pub fn unlink(path: *const c_char) -> c_int;
+        pub fn stat64(path: *const c_char, buf: *mut super::Stat) -> c_int;
+        pub fn lstat64(path: *const c_char, buf: *mut super::Stat) -> c_int;
+        pub fn fstat64(fd: c_int, buf: *mut super::Stat) -> c_int;
+        pub fn chmod(path: *const c_char, mode: c_int) -> c_int;
+        pub fn fchmod(fd: c_int, mode: c_int) -> c_int;
+        pub fn mkdir(path: *const c_char, mode: c_int) -> c_int;
+        pub fn rmdir(path: *const c_char) -> c_int;
+        pub fn opendir(path: *const c_char) -> *mut DIR;
+        pub fn readdir64(dir: *mut DIR) -> *mut super::Dirent;
+        pub fn closedir(dir: *mut DIR) -> c_int;
+        pub fn rename(old: *const c_char, new: *const c_char) -> c_int;
+        pub fn utimes(path: *const c_char, times: *const [i32; 2]) -> c_int;
+    }
+
+    /// The opaque `DIR` of the C library.
+    #[repr(C)]
+    pub struct DIR {
+        _private: [u8; 0],
+    }
+}
+
+/// Runs `f` with the path as a C string. An empty path is `NotFound`, as on Unix: DOS would take it
+/// for the current directory.
+fn with_path<T>(path: &Path, f: &dyn Fn(&CStr) -> io::Result<T>) -> io::Result<T> {
+    if path.as_os_str().is_empty() {
+        return Err(io::Error::from_raw_os_error(ENOENT));
+    }
+    run_path_with_cstr(&crate::sys::path::to_dos_path(path), f)
+}
+
+/// The error of the C call that just failed. Some failures of the C library leave `errno` as an
+/// earlier call set it, which can be 0; that would read "Success", so it is reported as it is.
+fn last_error() -> io::Error {
+    let error = io::Error::from_raw_os_error(errno());
+    if error.raw_os_error() == Some(0) {
+        io::const_error!(io::ErrorKind::Other, "the C library failed without an error code")
+    } else {
+        error
+    }
+}
+
+/// A result of a C call that is -1 on failure, as an `io::Result`.
+fn cvt<T: PartialEq + Default + Copy>(value: T, failure: T) -> io::Result<T> {
+    if value == failure { Err(last_error()) } else { Ok(value) }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+
+    fn access_mode(&self) -> io::Result<c_int> {
+        match (self.read, self.write, self.append) {
+            (true, false, false) => Ok(flag::O_RDONLY),
+            (false, true, false) => Ok(flag::O_WRONLY),
+            (true, true, false) => Ok(flag::O_RDWR),
+            (false, _, true) => Ok(flag::O_WRONLY | flag::O_APPEND),
+            (true, _, true) => Ok(flag::O_RDWR | flag::O_APPEND),
+            (false, false, false) => Err(io::Error::from_raw_os_error(EINVAL)),
+        }
+    }
+
+    fn creation_mode(&self) -> io::Result<c_int> {
+        match (self.write, self.append) {
+            (true, false) => {}
+            (false, false) => {
+                if self.truncate || self.create || self.create_new {
+                    return Err(io::Error::from_raw_os_error(EINVAL));
+                }
+            }
+            (_, true) => {
+                if self.truncate && !self.create_new {
+                    return Err(io::Error::from_raw_os_error(EINVAL));
+                }
+            }
+        }
+        Ok(match (self.create, self.truncate, self.create_new) {
+            (false, false, false) => 0,
+            (true, false, false) => flag::O_CREAT,
+            (false, true, false) => flag::O_TRUNC,
+            (true, true, false) => flag::O_CREAT | flag::O_TRUNC,
+            (_, _, true) => flag::O_CREAT | flag::O_EXCL,
+        })
+    }
+}
