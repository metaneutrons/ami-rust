diff --git a/library/std/src/sys/pal/aros/mod.rs b/library/std/src/sys/pal/aros/mod.rs
new file mode 100644
index 0000000..d3dbf07
--- /dev/null
+++ b/library/std/src/sys/pal/aros/mod.rs
@@ -0,0 +1,72 @@
+//! The platform layer for AROS: the AROS C library and the native bridge that
+//! the toolchain links into every program.
+
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use crate::io as std_io;
+
+unsafe extern "C" {
+    /// The native fatal path of the bridge. It records a diagnostic, releases
+    /// what the program still holds and ends the process with return code 20.
+    /// It never returns, so no "Software Failure" requester can appear.
+    fn sdk_fatal(reason: u64) -> !;
+
+    /// The entry that rustc generates for a program with `fn main`. The target
+    /// specifications of AROS rename it from `main`, which is the symbol of the
+    /// native bridge, to this name (the target option `entry-name`).
+    fn ami_rust_entry(argc: isize, argv: *const *const u8) -> isize;
+}
+
+/// The reason that the native diagnostic ("ami-rust fatal 2") records when
+/// `std` aborts, which includes every panic under `panic = "abort"`.
+const FATAL_STD_ABORT: u64 = 2;
+
+// SAFETY: must be called only once during runtime initialization.
+// NOTE: this is not guaranteed to run, for example when Rust code is called externally.
+pub unsafe fn init(_argc: isize, _argv: *const *const u8, _sigpipe: u8) {}
+
+// SAFETY: must be called only once during runtime cleanup.
+// NOTE: this is not guaranteed to run, for example when the program aborts.
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn abort_internal() -> ! {
+    // SAFETY: the symbol is defined by the native bridge that every program of
+    // this target links; the call never returns.
+    unsafe { sdk_fatal(FATAL_STD_ABORT) }
+}
+
+/// The function that the native `main` calls once the bridge is set up, which is
+/// where a program with `fn main` starts.
+///
+/// The native `main` stays the only owner of the task: it has run `sdk_begin`
+/// before this and runs `sdk_end` after it. The arguments are those that the
+/// C start-up stored, so the one claim of the `aros` context stays free for the
+/// program. The exit status keeps the contract of the native start-up, where
+/// only 0, 10 and 20 may be returned:
+///
+/// - 0 is success, and 20 is what a panic or abort ends with;
+/// - 1, which is what an error returned from `main` gives, is reported as 10;
+/// - any other code leaves through `process::exit`, which passes it as it is.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_sdk_main() -> i32 {
+    unsafe extern "C" {
+        static __argc: crate::ffi::c_int;
+        static __argv: *const *const u8;
+    }
+    // SAFETY: the C start-up sets both before it calls the native `main`.
+    let code = unsafe { ami_rust_entry(__argc as isize, __argv) } as i32;
+    match code {
+        0 => 0,
+        1 => 10,
+        10 | 20 => code,
+        other => crate::sys::exit::exit(other),
+    }
+}
