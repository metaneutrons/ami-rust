diff --git a/library/std/src/sys/fs/aros.rs b/library/std/src/sys/fs/aros.rs
new file mode 100644
index 0000000..b4deed0
--- /dev/null
+++ b/library/std/src/sys/fs/aros.rs
@@ -0,0 +1,1060 @@
+//! The file system of AROS through the C library (descriptors, `open`, `read`, `write`, `lseek`).
+//!
+//! Metadata and directories use the 64-bit entry points (`stat64`, `readdir64`), because the plain
+//! `struct stat` of ABI-v1 is laid out differently from that of ABI-v11 and the 64-bit one is not.
+//!
+//! Everything that is not implemented here is the `unsupported` fallback and returns
+//! `ErrorKind::Unsupported`; the list is in `docs/plans/std-m3-findings.md`.
+
+use crate::ffi::{CStr, OsString, c_char, c_int};
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU64, Ordering};
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Path, PathBuf};
+pub use crate::sys::fs::common::{Dir, copy, exists, remove_dir_all};
+use crate::sys::helpers::run_path_with_cstr;
+use crate::sys::io::{errno, set_errno};
+use crate::sys::pal::{ClibLock, without_requesters};
+use crate::sys::time::SystemTime;
+use crate::sys::unsupported;
+
+pub struct File {
+    fd: c_int,
+    readable: bool,
+    writable: bool,
+    append: bool,
+    /// The position of a seek past the end of the file, or `NO_POSITION`. See `File::seek`. It is
+    /// shared with the duplicates of the handle, as the position of the descriptor is.
+    beyond_end: Arc<AtomicU64>,
+    /// The absolute path that the file was opened with, for `set_times`: the C library has no
+    /// `futimes`. DOS refuses to rename or delete a file that is open, so it stays valid.
+    path: Option<Arc<PathBuf>>,
+    /// A modification time set through a handle that can write, as seconds since 1970, or 0. DOS sets
+    /// the date of a written file to "now" when it is closed, so the date is set again after the last
+    /// duplicate is closed. A write after `set_times` cancels it, as it changes the date on Unix too.
+    pending_date: Arc<AtomicU64>,
+}
+
+/// No seek past the end is remembered.
+const NO_POSITION: u64 = u64::MAX;
+
+/// The `struct timespec` of the C library: a 32-bit `time_t` and a 64-bit `long`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CTimespec {
+    tv_sec: i32,
+    tv_nsec: i64,
+}
+
+/// `struct stat64`. It is laid out the same on both ABIs (the offsets were taken from the C SDK of
+/// each), which the plain `struct stat` is not: on ABI-v1 its `st_ino` is 32 bits wide and moves
+/// `st_mode` and `st_size`. The fields that `std` does not use are only there to place the others.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Stat {
+    st_dev: u64,
+    st_ino: u64,
+    st_mode: u16,
+    st_nlink: u16,
+    st_uid: u32,
+    st_gid: u32,
+    st_pad: u32,
+    st_rdev: u64,
+    st_size: i64,
+    st_atim: CTimespec,
+    st_mtim: CTimespec,
+    st_ctim: CTimespec,
+    st_blksize: i64,
+    st_blocks: i64,
+    st_flags: u64,
+    st_gen: u64,
+}
+
+const _: () = {
+    assert!(crate::mem::size_of::<Stat>() == 128);
+    assert!(crate::mem::offset_of!(Stat, st_mode) == 16);
+    assert!(crate::mem::offset_of!(Stat, st_size) == 40);
+    assert!(crate::mem::offset_of!(Stat, st_atim) == 48);
+    assert!(crate::mem::offset_of!(Stat, st_mtim) == 64);
+};
+
+/// `struct dirent64`, identical on both ABIs.
+#[repr(C)]
+struct Dirent {
+    d_ino: u64,
+    d_off: i64,
+    d_reclen: u16,
+    d_type: u8,
+    d_name: [c_char; 256],
+}
+
+const _: () = {
+    assert!(crate::mem::offset_of!(Dirent, d_type) == 18);
+    assert!(crate::mem::offset_of!(Dirent, d_name) == 19);
+};
+
+/// The file type bits of `st_mode` and the values of `d_type`.
+const S_IFMT: u32 = 0o170000;
+const S_IFDIR: u32 = 0o040000;
+const S_IFREG: u32 = 0o100000;
+const S_IFLNK: u32 = 0o120000;
+const DT_DIR: u8 = 4;
+const DT_REG: u8 = 8;
+const DT_LNK: u8 = 10;
+
+#[derive(Clone)]
+pub struct FileAttr {
+    stat: Stat,
+}
+
+struct DirStream(*mut c::DIR);
+
+// SAFETY: the stream is only read through `&mut ReadDir`; the entries that share it only read the
+// path of the directory.
+unsafe impl Send for DirStream {}
+unsafe impl Sync for DirStream {}
+
+impl Drop for DirStream {
+    fn drop(&mut self) {
+        // SAFETY: the stream was opened by `readdir` and is closed only here.
+        unsafe { c::closedir(self.0) };
+    }
+}
+
+struct InnerReadDir {
+    stream: DirStream,
+    root: PathBuf,
+}
+
+pub struct ReadDir {
+    inner: Arc<InnerReadDir>,
+    end_of_stream: bool,
+}
+
+pub struct DirEntry {
+    dir: Arc<InnerReadDir>,
+    name: Vec<u8>,
+    d_type: u8,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    accessed: Option<SystemTime>,
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct FilePermissions {
+    mode: u32,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    mode: u32,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.stat.st_size as u64
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { mode: u32::from(self.stat.st_mode) & 0o7777 }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { mode: u32::from(self.stat.st_mode) & S_IFMT }
+    }
+
+    /// DOS keeps one date per file; the C library reports it as all three times, so
+    /// `modified` and `accessed` are the same, and the resolution is one second.
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        let t = self.stat.st_mtim;
+        Ok(SystemTime::from_c_seconds(t.tv_sec, t.tv_nsec))
+    }
