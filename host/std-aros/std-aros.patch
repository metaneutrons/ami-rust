diff --git a/library/std/src/sys/paths/aros.rs b/library/std/src/sys/paths/aros.rs
new file mode 100644
index 0000000..d6b7990
--- /dev/null
+++ b/library/std/src/sys/paths/aros.rs
@@ -0,0 +1,138 @@
+//! The current directory, the temporary directory and path lists on AROS.
+
+use crate::ffi::{CStr, OsStr, OsString, c_char, c_int};
+use crate::path::{self, PathBuf};
+use crate::sys::helpers::run_path_with_cstr;
+use crate::sys::io::errno;
+use crate::sys::pal::{ClibLock, without_requesters};
+use crate::{fmt, io, slice};
+
+/// The separator of a list of paths. A colon is part of a volume name here, so it is the semicolon.
+const PATH_SEPARATOR: u8 = b';';
+
+/// `ERANGE`, `ENOENT` and `ENOTDIR` in the numbering of the C library.
+const ERANGE: i32 = 34;
+const ENOENT: i32 = 2;
+const ENOTDIR: i32 = 20;
+
+mod c {
+    use crate::ffi::{c_char, c_int};
+
+    unsafe extern "C" {
+        pub fn getcwd(buf: *mut c_char, size: usize) -> *mut c_char;
+        pub fn chdir(path: *const c_char) -> c_int;
+    }
+}
+
+/// The error of the C call that just failed; `errno` can be 0 (see `sys::fs`).
+fn last_error() -> io::Error {
+    match errno() {
+        0 => io::const_error!(io::ErrorKind::Other, "the C library failed without an error code"),
+        error => io::Error::from_raw_os_error(error),
+    }
+}
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    let _clib = ClibLock::new();
+    let mut buf: Vec<u8> = Vec::with_capacity(512);
+    loop {
+        // SAFETY: the buffer has `capacity` writable bytes.
+        let ptr = unsafe { c::getcwd(buf.as_mut_ptr().cast::<c_char>(), buf.capacity()) };
+        if !ptr.is_null() {
+            // SAFETY: the C library wrote a C string into the buffer.
+            let len = unsafe { CStr::from_ptr(buf.as_ptr().cast::<c_char>()) }.to_bytes().len();
+            // SAFETY: `len` bytes were initialised by the call.
+            unsafe { buf.set_len(len) };
+            buf.shrink_to_fit();
+            // SAFETY: the name is what DOS gave, as `std` stores every path.
+            return Ok(PathBuf::from(unsafe { OsString::from_encoded_bytes_unchecked(buf) }));
+        }
+        if errno() != ERANGE {
+            return Err(last_error());
+        }
+        // Require more space than the current capacity.
+        let cap = buf.capacity();
+        buf.reserve(cap * 2);
+    }
+}
+
+pub fn chdir(p: &path::Path) -> io::Result<()> {
+    if p.as_os_str().is_empty() {
+        return Err(io::Error::from_raw_os_error(ENOENT));
+    }
+    // DOS locks a file as willingly as a directory, and the current directory would then be a file.
+    if !crate::sys::fs::metadata(p)?.file_type().is_dir() {
+        return Err(io::Error::from_raw_os_error(ENOTDIR));
+    }
+    let _clib = ClibLock::new();
+    let result = run_path_with_cstr(&crate::sys::path::to_dos_path(p), &|p| {
+        // SAFETY: `p` is a valid C string.
+        Ok(without_requesters(|| unsafe { c::chdir(p.as_ptr()) }))
+    })?;
+    if result == 0 { Ok(()) } else { Err(last_error()) }
+}
+
+pub struct SplitPaths<'a> {
+    parts: slice::Split<'a, u8, fn(&u8) -> bool>,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    fn is_separator(&b: &u8) -> bool {
+        b == PATH_SEPARATOR
+    }
+    SplitPaths { parts: unparsed.as_encoded_bytes().split(is_separator as fn(&u8) -> bool) }
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+
+    fn next(&mut self) -> Option<PathBuf> {
+        // SAFETY: split at an ASCII byte of a valid encoding.
+        self.parts.next().map(|part| PathBuf::from(unsafe { OsStr::from_encoded_bytes_unchecked(part) }))
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_encoded_bytes();
+        if i > 0 {
+            joined.push(PATH_SEPARATOR)
+        }
+        if path.contains(&PATH_SEPARATOR) {
+            return Err(JoinPathsError);
+        }
+        joined.extend_from_slice(path);
+    }
+    // SAFETY: pieces of valid encodings joined by an ASCII byte.
+    Ok(unsafe { OsString::from_encoded_bytes_unchecked(joined) })
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "path segment contains separator `{}`", char::from(PATH_SEPARATOR))
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+/// The program's own path is not available through the C library.
+pub fn current_exe() -> io::Result<PathBuf> {
+    crate::sys::pal::unsupported()
+}
+
+/// `T:` is the assign that AROS uses for temporary files.
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from("T:")
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    None
+}
