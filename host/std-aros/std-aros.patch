+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        let t = self.stat.st_atim;
+        Ok(SystemTime::from_c_seconds(t.tv_sec, t.tv_nsec))
+    }
+
+    /// DOS has no creation date.
+    pub fn created(&self) -> io::Result<SystemTime> {
+        unsupported()
+    }
+}
