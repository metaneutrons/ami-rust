+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        if self.end_of_stream {
+            return None;
+        }
+        let _clib = ClibLock::new();
+        loop {
+            // `readdir64` returns null both at the end and on an error, and only sets `errno` for
+            // the error.
+            set_errno(0);
+            // SAFETY: the stream is open for as long as `self.inner` exists.
+            let entry = unsafe { c::readdir64(self.inner.stream.0) };
+            if entry.is_null() {
+                self.end_of_stream = true;
+                return match errno() {
+                    0 => None,
+                    error => Some(Err(io::Error::from_raw_os_error(error))),
+                };
+            }
+            // SAFETY: a non-null entry is valid until the next call, and its name is a C string.
+            let (name, d_type) = unsafe {
+                (CStr::from_ptr((*entry).d_name.as_ptr()).to_bytes().to_vec(), (*entry).d_type)
+            };
+            // The C library lists `.` and `..` when it emulates Unix paths.
+            if name == b"." || name == b".." {
+                continue;
+            }
+            return Some(Ok(DirEntry { dir: Arc::clone(&self.inner), name, d_type }));
+        }
+    }
+}
