+impl Drop for File {
+    fn drop(&mut self) {
+        // SAFETY: `fd` was opened by this `File` and is closed only here. An error from `close`
+        // cannot be reported from a destructor.
+        unsafe { c::close(self.fd) };
+        // The last handle of a file whose date was set: DOS has just set it to "now".
+        let pending = self.pending_date.load(Ordering::Relaxed);
+        if pending != 0 && Arc::strong_count(&self.pending_date) == 1 {
+            if let Some(path) = &self.path {
+                let mut times = FileTimes::default();
+                times.set_modified(SystemTime::from_c_seconds(pending as u32 as i32, 0));
+                let _ = set_times(path, times);
+            }
+        }
+    }
+}
