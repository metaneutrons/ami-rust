diff --git a/library/std/src/sys/stdio/aros.rs b/library/std/src/sys/stdio/aros.rs
new file mode 100644
index 0000000..1e176be
--- /dev/null
+++ b/library/std/src/sys/stdio/aros.rs
@@ -0,0 +1,95 @@
+//! Standard input, output and error on the file descriptors 0, 1 and 2 of the
+//! AROS C library, which map to the DOS streams of the process.
+
+use crate::ffi::{c_int, c_void};
+use crate::io;
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+unsafe extern "C" {
+    fn read(fd: c_int, buffer: *mut c_void, count: usize) -> isize;
+    fn write(fd: c_int, buffer: *const c_void, count: usize) -> isize;
+}
+
+const STDIN_FILENO: c_int = 0;
+const STDOUT_FILENO: c_int = 1;
+const STDERR_FILENO: c_int = 2;
+
+/// `EBADF` in the numbering of the AROS C library (NetBSD's).
+const EBADF: i32 = 9;
+
+/// The largest single transfer. DOS takes a signed 32-bit length, so a larger
+/// buffer is transferred in several calls by the callers' own loops.
+const MAX_TRANSFER: usize = 1 << 30;
+
+fn read_fd(fd: c_int, buf: &mut [u8]) -> io::Result<usize> {
+    let count = buf.len().min(MAX_TRANSFER);
+    // SAFETY: `buf` is valid for `count` bytes.
+    let n = unsafe { read(fd, buf.as_mut_ptr().cast(), count) };
+    if n < 0 { Err(io::Error::last_os_error()) } else { Ok(n as usize) }
+}
+
+fn write_fd(fd: c_int, buf: &[u8]) -> io::Result<usize> {
+    let count = buf.len().min(MAX_TRANSFER);
+    // SAFETY: `buf` is valid for `count` bytes.
+    let n = unsafe { write(fd, buf.as_ptr().cast(), count) };
+    if n < 0 { Err(io::Error::last_os_error()) } else { Ok(n as usize) }
+}
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        read_fd(STDIN_FILENO, buf)
+    }
+}
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_fd(STDOUT_FILENO, buf)
+    }
+
+    #[inline]
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_fd(STDERR_FILENO, buf)
+    }
+
+    #[inline]
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub fn is_ebadf(err: &io::Error) -> bool {
+    err.raw_os_error() == Some(EBADF)
+}
+
+pub const STDIN_BUF_SIZE: usize = crate::sys::io::DEFAULT_BUF_SIZE;
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
