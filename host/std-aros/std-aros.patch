diff --git a/library/std/src/sys/thread_local/key/aros.rs b/library/std/src/sys/thread_local/key/aros.rs
new file mode 100644
index 0000000..d7ea314
--- /dev/null
+++ b/library/std/src/sys/thread_local/key/aros.rs
@@ -0,0 +1,103 @@
+//! Thread-local keys on AROS: task storage slots, through the native bridge (in task.resource on
+//! ABI-v1, in exec.library 51 on ABI-v11). A new task starts with every slot at 0.
+//!
+//! AROS runs no destructors for a slot, so they are kept in a list here and `run_dtors` calls them
+//! when a thread that `std` started ends, as on Xous. The main task's values are not destroyed.
+
+use crate::alloc::System;
+use crate::mem::ManuallyDrop;
+use crate::ptr;
+use crate::sync::atomic::Ordering::{Acquire, Release};
+use crate::sync::atomic::{Atomic, AtomicPtr};
+
+pub type Key = usize;
+pub type Dtor = unsafe extern "C" fn(*mut u8);
+
+unsafe extern "C" {
+    fn sdk_tls_alloc() -> crate::ffi::c_long;
+    fn sdk_tls_set(slot: crate::ffi::c_long, value: usize) -> crate::ffi::c_int;
+    fn sdk_tls_get(slot: crate::ffi::c_long) -> usize;
+}
+
+struct Node {
+    dtor: Dtor,
+    key: Key,
+    next: *mut Node,
+}
+
+static DTORS: Atomic<*mut Node> = AtomicPtr::new(ptr::null_mut());
+
+pub fn create(dtor: Option<Dtor>) -> Key {
+    // SAFETY: no precondition.
+    let slot = unsafe { sdk_tls_alloc() };
+    if slot <= 0 {
+        rtabort!("no task storage slot for a thread-local key");
+    }
+    let key = slot as Key;
+    if let Some(dtor) = dtor {
+        // SAFETY: the key was just created.
+        unsafe { register_dtor(key, dtor) };
+    }
+    key
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    // SAFETY: the key is a slot that `create` allocated.
+    if unsafe { sdk_tls_set(key as crate::ffi::c_long, value.expose_provenance()) } == 0 {
+        rtabort!("a thread-local value could not be stored");
+    }
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    // SAFETY: as above.
+    ptr::with_exposed_provenance_mut(unsafe { sdk_tls_get(key as crate::ffi::c_long) })
+}
+
+pub unsafe fn destroy(_key: Key) {
+    // Only reached when `LazyKey` loses the race to make its key. The slot is kept: its destructor
+    // is already registered, and AROS would give a freed slot to the next key, which would then run
+    // the wrong destructor. One slot per lost race is lost.
+}
+
+unsafe fn register_dtor(key: Key, dtor: Dtor) {
+    // The System allocator, so that a global allocator that uses thread-locals is not entered.
+    let mut node = ManuallyDrop::new(Box::new_in(Node { key, dtor, next: ptr::null_mut() }, System));
+    let mut head = DTORS.load(Acquire);
+    loop {
+        node.next = head;
+        match DTORS.compare_exchange(head, &mut **node, Release, Acquire) {
+            Ok(_) => return,
+            Err(current) => head = current,
+        }
+    }
+}
+
+/// Runs the destructors of this thread's values, five rounds at most, as on Windows: a destructor
+/// can set another thread-local.
+pub unsafe fn run_dtors() {
+    let mut any_run = true;
+    for _ in 0..5 {
+        if !any_run {
+            break;
+        }
+        any_run = false;
+        let mut current = DTORS.load(Acquire);
+        while !current.is_null() {
+            // SAFETY: nodes are never freed.
+            let (key, dtor, next) = unsafe { ((*current).key, (*current).dtor, (*current).next) };
+            // SAFETY: the key is valid.
+            let value = unsafe { get(key) };
+            if !value.is_null() {
+                // SAFETY: as above; the value belongs to this thread.
+                unsafe {
+                    set(key, ptr::null_mut());
+                    dtor(value);
+                }
+                any_run = true;
+            }
+            current = next;
+        }
+    }
+}
