diff --git a/library/std/src/os/aros/fs.rs b/library/std/src/os/aros/fs.rs
new file mode 100644
index 0000000..1bab84d
--- /dev/null
+++ b/library/std/src/os/aros/fs.rs
@@ -0,0 +1,56 @@
+//! AROS-specific behaviour of `std::fs`.
+
+#![unstable(feature = "aros_ext", issue = "none")]
+
+use crate::sys;
+
+/// Whether `std::fs` leaves DOS requesters on.
+///
+/// A path on a volume that is not there makes DOS open a "Please insert volume X in any drive"
+/// requester and wait for a person. By default `std` switches requesters off around every call
+/// that resolves a path, so that such a call fails with `ErrorKind::NotFound` at once and a
+/// program that was started from a script never waits. This returns `false` in that case.
+///
+/// The setting belongs to the whole program, not to one task.
+#[unstable(feature = "aros_ext", issue = "none")]
+pub fn requesters() -> bool {
+    sys::requesters_enabled()
+}
+
+/// Sets whether `std::fs` leaves DOS requesters on, from now on and until it is changed again.
+///
+/// With `true`, a call on a missing volume opens the requester and waits for a person, as a
+/// program written for DOS does. With `false` (the default) it fails at once. The change applies
+/// to calls that start after it, from every task of the program.
+///
+/// # Examples
+///
+/// ```ignore (only on AROS)
+/// #![feature(aros_ext)]
+/// use std::os::aros::fs::set_requesters;
+///
+/// set_requesters(true);
+/// let file = std::fs::File::open("DF0:data"); // may ask the user to insert the disk
+/// set_requesters(false);
+/// ```
+#[unstable(feature = "aros_ext", issue = "none")]
+pub fn set_requesters(enabled: bool) {
+    sys::set_requesters_enabled(enabled);
+}
+
+/// Runs `f` with requesters on, and restores the previous setting afterwards, also when `f`
+/// panics.
+///
+/// Other tasks of the program see the setting while `f` runs, because it belongs to the whole
+/// program.
+#[unstable(feature = "aros_ext", issue = "none")]
+pub fn with_requesters<T>(f: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            sys::set_requesters_enabled(self.0);
+        }
+    }
+    let _restore = Restore(sys::set_requesters_enabled(true));
+    f()
+}
