diff --git a/library/std/src/sys/env/aros.rs b/library/std/src/sys/env/aros.rs
new file mode 100644
index 0000000..0ffb722
--- /dev/null
+++ b/library/std/src/sys/env/aros.rs
@@ -0,0 +1,84 @@
+//! Environment variables of an AROS program are DOS variables. The C library
+//! reads them with `GetVar`, and `setenv` writes them as variables that are
+//! local to the process. Each DOS process has its own local variables, so a
+//! thread sees the variables of its parent as they were when it started, and its own
+//! changes; no other thread sees them. Calls are made under the C-library lock: `getenv`
+//! returns a buffer of the C library that the next call can reuse.
+
+use crate::ffi::{CStr, OsStr, OsString, c_char, c_int};
+use crate::io;
+use crate::sys::helpers::run_with_cstr;
+use crate::sys::pal::ClibLock;
+
+pub use super::common::Env;
+
+mod c {
+    use crate::ffi::{c_char, c_int};
+
+    unsafe extern "C" {
+        pub fn getenv(name: *const c_char) -> *const c_char;
+        pub fn setenv(name: *const c_char, value: *const c_char, overwrite: c_int) -> c_int;
+        pub fn unsetenv(name: *const c_char) -> c_int;
+    }
+}
+
+/// `EINVAL` in the numbering of the AROS C library (NetBSD's).
+const EINVAL: i32 = 22;
+
+/// The C library has no way to list DOS variables, so the environment of a
+/// program always looks empty to `env::vars`. `env::var` still finds a named
+/// variable.
+pub fn env() -> Env {
+    Env::new(Vec::new())
+}
+
+fn invalid(name: &OsStr) -> bool {
+    let bytes = name.as_encoded_bytes();
+    bytes.is_empty() || bytes.contains(&b'=')
+}
+
+pub fn getenv(k: &OsStr) -> Option<OsString> {
+    // A name with a nul byte, or with an equals sign, cannot be set, so its
+    // value is always `None` as well.
+    let _clib = ClibLock::new();
+    run_with_cstr(k.as_encoded_bytes(), &|k| {
+        // SAFETY: `k` is a valid C string. The C library caches the value per
+        // name, so it is copied out at once.
+        let v: *const c_char = unsafe { c::getenv(k.as_ptr()) };
+        if v.is_null() {
+            Ok(None)
+        } else {
+            let bytes = unsafe { CStr::from_ptr(v) }.to_bytes().to_vec();
+            // SAFETY: the bytes come from a variable value of this platform.
+            Ok(Some(unsafe { OsString::from_encoded_bytes_unchecked(bytes) }))
+        }
+    })
+    .ok()
+    .flatten()
+}
+
+pub unsafe fn setenv(k: &OsStr, v: &OsStr) -> io::Result<()> {
+    if invalid(k) {
+        return Err(io::Error::from_raw_os_error(EINVAL));
+    }
+    let _clib = ClibLock::new();
+    run_with_cstr(k.as_encoded_bytes(), &|k| {
+        run_with_cstr(v.as_encoded_bytes(), &|v| {
+            // SAFETY: both are valid C strings.
+            let result: c_int = unsafe { c::setenv(k.as_ptr(), v.as_ptr(), 1) };
+            if result == 0 { Ok(()) } else { Err(io::Error::last_os_error()) }
+        })
+    })
+}
+
+pub unsafe fn unsetenv(n: &OsStr) -> io::Result<()> {
+    if invalid(n) {
+        return Err(io::Error::from_raw_os_error(EINVAL));
+    }
+    let _clib = ClibLock::new();
+    run_with_cstr(n.as_encoded_bytes(), &|n| {
+        // SAFETY: `n` is a valid C string.
+        let result: c_int = unsafe { c::unsetenv(n.as_ptr()) };
+        if result == 0 { Ok(()) } else { Err(io::Error::last_os_error()) }
+    })
+}
