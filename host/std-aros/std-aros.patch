diff --git a/library/std/src/sys/path/aros.rs b/library/std/src/sys/path/aros.rs
new file mode 100644
index 0000000..9fb2cd7
--- /dev/null
+++ b/library/std/src/sys/path/aros.rs
@@ -0,0 +1,127 @@
+//! Paths on AROS: `volume:dir/dir/name`.
+//!
+//! A path starts with the name of a volume or an assign and a colon (`RAM:`, `SYS:`, `T:`) or is
+//! relative to the current directory. `/` separates the names, and DOS also reads a leading `/` as "the
+//! parent directory" and `:` alone as "the root of the current volume".
+//!
+//! `std` reports the volume with its colon as the prefix of the path, in the form of
+//! `Prefix::DeviceNS` (`Path::new("RAM:T/x").components()` starts with `Prefix(RAM:)`), and like the
+//! drive of Windows (`C:`) it is followed directly by the path: `Path::new("RAM:").join("x")` is
+//! `RAM:x`. A path with a volume is absolute. What `std` does not model: DOS reads two slashes in a
+//! row as "up one directory", `Path` collapses them as on Unix.
+
+use crate::borrow::Cow;
+use crate::ffi::{OsStr, OsString};
+use crate::path::{Component, Path, PathBuf, Prefix};
+use crate::{env, io};
+
+path_separator_bytes!(b'/');
+
+#[inline]
+pub const fn is_verbatim_sep(b: u8) -> bool {
+    is_sep_byte(b)
+}
+
+/// The volume of a path: the text up to the first colon, if no slash comes before it.
+pub fn parse_prefix(path: &OsStr) -> Option<Prefix<'_>> {
+    let bytes = path.as_encoded_bytes();
+    let end = bytes.iter().position(|&b| b == b':' || b == b'/')?;
+    if bytes[end] == b':' && end > 0 {
+        // SAFETY: cut after an ASCII byte of a valid encoding.
+        Some(Prefix::DeviceNS(unsafe { OsStr::from_encoded_bytes_unchecked(&bytes[..=end]) }))
+    } else {
+        None
+    }
+}
+
+pub const HAS_PREFIXES: bool = true;
+
+/// The path as DOS reads it. DOS knows neither `.` nor `..` (a name of that kind is "not found"; the
+/// parent directory is a leading `/`), and Rust programs use both all the time, so `std` resolves them
+/// before a path goes to the C library: `.` and empty names are dropped, `..` removes the name before
+/// it, and a `..` with nothing before it in a relative path becomes a leading `/` (the parent in DOS). At
+/// the root of a volume `..` stays at the root. This is lexical, as in `path::absolute`: it does not
+/// look at the file system, so a link or a name that does not exist is not noticed. A leading
+/// slash is the user's own DOS "parent" and stays. A path with none of these is passed unchanged.
+pub(crate) fn to_dos_path(path: &Path) -> Cow<'_, Path> {
+    let bytes = path.as_os_str().as_encoded_bytes();
+    let volume = match parse_prefix(path.as_os_str()) {
+        Some(Prefix::DeviceNS(v)) => v.as_encoded_bytes().len(),
+        _ => 0,
+    };
+    let leading = if volume == 0 { bytes.iter().take_while(|&&b| b == b'/').count() } else { 0 };
+    let rest = &bytes[volume + leading..];
+    // A single trailing slash is fine; an empty name anywhere else, `.` and `..` are not.
+    let trimmed = rest.strip_suffix(b"/").unwrap_or(rest);
+    let plain = trimmed.is_empty()
+        || trimmed.split(|&b| b == b'/').all(|part| !part.is_empty() && part != b"." && part != b"..");
+    if plain {
+        return Cow::Borrowed(path);
+    }
+    let mut names: Vec<&[u8]> = Vec::new();
+    let mut parents = leading;
+    for part in rest.split(|&b| b == b'/') {
+        match part {
+            b"" | b"." => {}
+            b".." => {
+                if names.pop().is_none() && volume == 0 {
+                    parents += 1;
+                }
+            }
+            name => names.push(name),
+        }
+    }
+    let mut out: Vec<u8> = Vec::with_capacity(bytes.len());
+    out.extend_from_slice(&bytes[..volume]);
+    out.resize(volume + parents, b'/');
+    for (i, name) in names.iter().enumerate() {
+        if i > 0 {
+            out.push(b'/');
+        }
+        out.extend_from_slice(name);
+    }
+    // SAFETY: pieces of a valid encoding joined by an ASCII byte.
+    Cow::Owned(PathBuf::from(unsafe { OsString::from_encoded_bytes_unchecked(out) }))
+}
+
+/// A path that names its volume.
+pub(crate) fn is_absolute(path: &Path) -> bool {
+    path.prefix().is_some()
+}
+
+/// Makes a path absolute without asking the file system.
+///
+/// A relative path goes below the current directory. DOS also knows paths that start with a colon (the
+/// root of the current volume) and with slashes (one parent directory for each); both are resolved
+/// here. `.` is dropped and `..` is kept, a trailing slash is not.
+pub(crate) fn absolute(path: &Path) -> io::Result<PathBuf> {
+    let bytes = path.as_os_str().as_encoded_bytes();
+    if bytes.is_empty() {
+        return Err(io::const_error!(io::ErrorKind::InvalidInput, "cannot make an empty path absolute"));
+    }
+    let mut base = PathBuf::new();
+    let mut rest = path;
+    let owned;
+    if !is_absolute(path) {
+        let cwd = env::current_dir()?;
+        if bytes[0] == b':' {
+            // The root of the current volume.
+            if let Some(Component::Prefix(volume)) = cwd.components().next() {
+                base.push(volume.as_os_str());
+            }
+            // SAFETY: cut after an ASCII byte of a valid encoding.
+            owned = PathBuf::from(unsafe { OsStr::from_encoded_bytes_unchecked(&bytes[1..]) });
+            rest = &owned;
+        } else {
+            let parents = bytes.iter().take_while(|&&b| b == b'/').count();
+            base = cwd;
+            for _ in 0..parents {
+                if let Some(parent) = base.parent() {
+                    base = parent.to_path_buf();
+                }
+            }
+        }
+    }
+    base.extend(rest.components().filter(|c| !matches!(c, Component::RootDir | Component::CurDir)));
+    Ok(base)
+}
