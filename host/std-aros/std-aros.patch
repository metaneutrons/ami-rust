+////////////////////////////////////////////////////////////////////////////////
+// The child and the state it shares with its parent
+////////////////////////////////////////////////////////////////////////////////
+
+/// What the process of the child does when it starts.
+struct Launch {
+    program: CString,
+    arguments: CString,
+    cwd: Option<OsString>,
+    env: Vec<(OsString, Option<OsString>)>,
+    stdin: Option<String>,
+    stdout: Option<String>,
+    stderr: Option<String>,
+    /// The handles of the parent, for a stream without a name.
+    handles: [usize; 3],
+    /// Another child whose output this one reads as input: it starts when that one has ended.
+    after: Option<Arc<Shared>>,
+}
+
+/// The state of a child, shared by the parent, the process that runs it and its pipes.
+pub struct Shared {
+    id: u32,
+    launch: Mutex<Option<Launch>>,
+    /// `None` while the child runs or has not started; the return code, or the DOS error that kept it
+    /// from running.
+    done: Mutex<Option<Result<i32, i32>>>,
+    ended: Condvar,
+    /// Files that the child reads, kept until it has ended.
+    keep: Mutex<Vec<Arc<TempFile>>>,
+}
+
+impl fmt::Debug for Shared {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Shared").field("id", &self.id).finish_non_exhaustive()
+    }
+}
+
+impl Shared {
+    fn new() -> Shared {
+        Shared {
+            id: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+            launch: Mutex::new(None),
+            done: Mutex::new(None),
+            ended: Condvar::new(),
+            keep: Mutex::new(Vec::new()),
+        }
+    }
+
+    fn keep(&self, file: Arc<TempFile>) {
+        self.keep.lock().unwrap().push(file);
+    }
+
+    /// Starts the process of the child, once.
+    fn start(self: &Arc<Shared>) -> io::Result<()> {
+        let Some(launch) = self.launch.lock().unwrap().take() else { return Ok(()) };
+        let shared = self.clone();
+        let spawned = crate::thread::Builder::new().name("std-process".to_string()).spawn(move || {
+            let result = run(launch);
+            *shared.done.lock().unwrap() = Some(result);
+            shared.ended.notify_all();
+        });
+        match spawned {
+            Ok(handle) => {
+                drop(handle);
+                Ok(())
+            }
+            Err(e) => Err(e),
+        }
+    }
+
+    fn finished(&self) -> Option<Result<i32, i32>> {
+        *self.done.lock().unwrap()
+    }
+
+    fn wait(self: &Arc<Shared>) -> Result<i32, i32> {
+        let mut done = self.done.lock().unwrap();
+        loop {
+            if let Some(result) = *done {
+                return result;
+            }
+            done = self.ended.wait(done).unwrap();
+        }
+    }
+}
+
+/// The body of the process that runs a child: its own directory and variables, then the command.
+fn run(launch: Launch) -> Result<i32, i32> {
+    if let Some(source) = &launch.after {
+        let _ = source.wait();
+    }
+    if let Some(dir) = &launch.cwd {
+        crate::sys::paths::chdir(Path::new(dir)).map_err(|e| e.raw_os_error().unwrap_or(1000))?;
+    }
+    for (name, value) in &launch.env {
+        // SAFETY: these are the variables of this process alone (see sys/env).
+        let _ = match value {
+            Some(value) => unsafe { crate::sys::env::setenv(name, value) },
+            None => unsafe { crate::sys::env::unsetenv(name) },
+        };
+    }
+    let name = |s: &Option<String>| s.as_ref().and_then(|s| CString::new(s.as_bytes()).ok());
+    let (input, output, error) = (name(&launch.stdin), name(&launch.stdout), name(&launch.stderr));
+    let pointer = |c: &Option<CString>| c.as_ref().map_or(crate::ptr::null(), |c| c.as_ptr());
+    let mut rc = 0i32;
+    // SAFETY: the strings are C strings that live until the call returns.
+    let code = unsafe {
+        sdk_proc_run(
+            launch.program.as_ptr(),
+            launch.arguments.as_ptr(),
+            pointer(&input),
+            pointer(&output),
+            pointer(&error),
+            launch.handles[0],
+            launch.handles[1],
+            launch.handles[2],
+            &mut rc,
+        )
+    };
+    drop(launch);
+    if code == 0 { Ok(rc) } else { Err(1000 + code as i32) }
+}
+
+pub struct Process {
+    shared: Arc<Shared>,
+    status: Option<ExitStatus>,
+}
+
+fn status_of(result: Result<i32, i32>) -> io::Result<ExitStatus> {
+    match result {
+        Ok(code) => Ok(ExitStatus(code)),
+        Err(os) => Err(io::Error::from_raw_os_error(os)),
+    }
+}
+
+impl Process {
+    /// A number for the child that is unique in this program; DOS has no process ids for it.
+    pub fn id(&self) -> u32 {
+        self.shared.id
+    }
+
+    pub fn kill(&mut self) -> io::Result<()> {
+        if self.status.is_some() || self.shared.finished().is_some() {
+            Ok(())
+        } else {
+            Err(io::Error::UNSUPPORTED_PLATFORM)
+        }
+    }
+
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        if let Some(status) = self.status {
+            return Ok(status);
+        }
+        self.shared.start()?;
+        let status = status_of(self.shared.wait())?;
+        self.status = Some(status);
+        Ok(status)
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        if let Some(status) = self.status {
+            return Ok(Some(status));
+        }
+        match self.shared.finished() {
+            None => Ok(None),
+            Some(result) => {
+                let status = status_of(result)?;
+                self.status = Some(status);
+                Ok(Some(status))
+            }
+        }
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// The pipes of a child: files in T:
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct ChildPipe {
+    kind: PipeKind,
+}
+
+enum PipeKind {
+    /// What the child writes. A read waits until it has ended, then reads the file.
+    Output { shared: Arc<Shared>, file: Arc<TempFile>, data: Mutex<Option<(Vec<u8>, usize)>> },
+    /// What the child reads. The child starts when this is dropped.
+    Input { shared: Arc<Shared>, file: Mutex<Option<fs::File>>, _temp: Arc<TempFile> },
+}
+
+impl ChildPipe {
+    fn input(shared: Arc<Shared>, temp: Arc<TempFile>, file: fs::File) -> ChildPipe {
+        ChildPipe { kind: PipeKind::Input { shared, file: Mutex::new(Some(file)), _temp: temp } }
+    }
+
+    fn output(shared: Arc<Shared>, file: Arc<TempFile>) -> ChildPipe {
+        ChildPipe { kind: PipeKind::Output { shared, file, data: Mutex::new(None) } }
+    }
+
+    /// Copies what is left of the child's output into `buf` after waiting for the child to end.
+    fn fill(&self, take: &mut dyn FnMut(&[u8]) -> usize) -> io::Result<usize> {
+        match &self.kind {
+            PipeKind::Output { shared, file, data } => {
+                let mut data = data.lock().unwrap();
+                if data.is_none() {
+                    // The child may not have started (its input is still open); it is a deadlock of the
+                    // program, as with a pipe, so the read waits.
+                    let _ = shared.wait();
+                    *data = Some((fs::read(&file.path)?, 0));
+                }
+                let (bytes, position) = data.as_mut().unwrap();
+                let taken = take(&bytes[*position..]);
+                *position += taken;
+                Ok(taken)
+            }
+            PipeKind::Input { .. } => Err(io::const_error!(io::ErrorKind::Unsupported, "the input of a child cannot be read")),
+        }
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.fill(&mut |rest| {
+            let n = rest.len().min(buf.len());
+            buf[..n].copy_from_slice(&rest[..n]);
+            n
+        })
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        self.fill(&mut |rest| {
+            let n = rest.len().min(cursor.capacity());
+            cursor.append(&rest[..n]);
+            n
+        })
+        .map(|_| ())
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        let mut total = 0;
+        for buf in bufs {
+            let n = self.read(buf)?;
+            total += n;
+            if n < buf.len() {
+                break;
+            }
+        }
+        Ok(total)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_to_end(&self, buf: &mut Vec<u8>) -> io::Result<usize> {
+        self.fill(&mut |rest| {
+            buf.extend_from_slice(rest);
+            rest.len()
+        })
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        match &self.kind {
+            PipeKind::Input { file, .. } => match file.lock().unwrap().as_mut() {
+                Some(file) => file.write(buf),
+                None => Err(io::const_error!(io::ErrorKind::BrokenPipe, "the input of the child is closed")),
+            },
+            PipeKind::Output { .. } => Err(io::const_error!(io::ErrorKind::Unsupported, "the output of a child cannot be written")),
+        }
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        match bufs.iter().find(|b| !b.is_empty()) {
+            Some(buf) => self.write(buf),
+            None => Ok(0),
+        }
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+}
+
+impl Drop for ChildPipe {
+    fn drop(&mut self) {
+        if let PipeKind::Input { shared, file, .. } = &self.kind {
+            // The input is complete: close the file, then let the child start.
+            drop(file.lock().unwrap().take());
+            let _ = shared.start();
+        }
+    }
+}
+
+impl fmt::Debug for ChildPipe {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ChildPipe").finish_non_exhaustive()
+    }
+}
+
+pub fn read_output(out: ChildPipe, stdout: &mut Vec<u8>, err: ChildPipe, stderr: &mut Vec<u8>) -> io::Result<()> {
+    out.read_to_end(stdout)?;
+    err.read_to_end(stderr)?;
+    Ok(())
+}
+
+pub fn getpid() -> u32 {
+    // SAFETY: no arguments; the number of the calling task.
+    unsafe { sdk_task_id() as u32 }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Exit status
+////////////////////////////////////////////////////////////////////////////////
+
+/// The return code of a command: 0 is success, 5 a warning, 10 an error and 20 a failure in the
+/// convention of DOS; a program may return any other value.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Default)]
+pub struct ExitStatus(i32);
+
+impl ExitStatus {
+    pub fn exit_ok(&self) -> Result<(), ExitStatusError> {
+        match NonZero::try_from(self.0) {
+            Ok(failure) => Err(ExitStatusError(failure)),
+            Err(_) => Ok(()),
+        }
+    }
+
+    pub fn code(&self) -> Option<i32> {
+        Some(self.0)
+    }
+}
+
+impl fmt::Display for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "exit code: {}", self.0)
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitStatusError(NonZero<i32>);
+
+impl Into<ExitStatus> for ExitStatusError {
+    fn into(self) -> ExitStatus {
+        ExitStatus(self.0.get())
+    }
+}
+
+impl ExitStatusError {
+    pub fn code(self) -> Option<NonZero<i32>> {
+        Some(self.0)
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitCode(u8);
+
+impl ExitCode {
+    pub const SUCCESS: ExitCode = ExitCode(0);
+    pub const FAILURE: ExitCode = ExitCode(1);
+
+    pub fn as_i32(&self) -> i32 {
+        self.0 as i32
+    }
+}
+
+impl From<u8> for ExitCode {
+    fn from(code: u8) -> Self {
+        Self(code)
+    }
+}
+
+pub struct CommandArgs<'a> {
+    iter: crate::slice::Iter<'a, OsString>,
+}
+
+impl<'a> Iterator for CommandArgs<'a> {
+    type Item = &'a OsStr;
+    fn next(&mut self) -> Option<&'a OsStr> {
+        self.iter.next().map(|os| &**os)
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+impl<'a> ExactSizeIterator for CommandArgs<'a> {
+    fn len(&self) -> usize {
+        self.iter.len()
+    }
+    fn is_empty(&self) -> bool {
+        self.iter.is_empty()
+    }
+}
+
+impl<'a> fmt::Debug for CommandArgs<'a> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list().entries(self.iter.clone()).finish()
+    }
+}
