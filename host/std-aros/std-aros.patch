diff --git a/library/std/src/sys/thread/aros.rs b/library/std/src/sys/thread/aros.rs
new file mode 100644
index 0000000..2cbee63
--- /dev/null
+++ b/library/std/src/sys/thread/aros.rs
@@ -0,0 +1,148 @@
+//! Threads on AROS. A thread is a DOS process, started and ended by the native bridge
+//! (`sdk_thread_spawn`, `sdk_thread_join`); see `sdk.c` for how a program ends while threads run.
+//! Sleeping is `nanosleep` of the C library, which waits on timer.device.
+//!
+//! Differences from Unix, because every DOS process has its own: the current directory
+//! (`env::set_current_dir`) and the local DOS variables (`env::set_var`) of a thread are its own; a new
+//! thread starts with copies of its parent's.
+
+use crate::ffi::{CStr, c_char, c_int, c_void};
+use crate::io;
+use crate::num::NonZero;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+/// The stack of a thread when the program asks for none. DOS processes usually get far less; Rust
+/// code needs more. `RUST_MIN_STACK` and `Builder::stack_size` choose another.
+pub const DEFAULT_MIN_STACK_SIZE: usize = 256 * 1024;
+
+unsafe extern "C" {
+    fn sdk_thread_spawn(
+        entry: extern "C" fn(*mut c_void),
+        arg: *mut c_void,
+        stack: usize,
+        name: *const c_char,
+    ) -> *mut c_void;
+    fn sdk_thread_join(handle: *mut c_void) -> c_int;
+    fn sdk_thread_detach(handle: *mut c_void);
+    fn sdk_thread_yield();
+    fn sdk_task_id() -> usize;
+}
+
+pub struct Thread {
+    handle: *mut c_void,
+}
+
+// SAFETY: the handle is a record of the bridge that any task may join or detach.
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+impl Thread {
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        // The name of the DOS process; DOS copies it.
+        let name: Vec<u8> = match init.handle.cname() {
+            Some(name) => name.to_bytes_with_nul().to_vec(),
+            None => b"rust thread\0".to_vec(),
+        };
+        let data = Box::into_raw(init);
+        // SAFETY: `thread_start` takes ownership of `data` when the process starts.
+        let handle = unsafe {
+            sdk_thread_spawn(thread_start, data.cast(), stack, name.as_ptr().cast())
+        };
+        if handle.is_null() {
+            // The process was not made, so `data` was not consumed.
+            drop(unsafe { Box::from_raw(data) });
+            return Err(io::const_error!(io::ErrorKind::Uncategorized, "unable to create a DOS process for the thread"));
+        }
+        return Ok(Thread { handle });
+
+        extern "C" fn thread_start(data: *mut c_void) {
+            // SAFETY: the box that `new` leaked.
+            let init = unsafe { Box::from_raw(data.cast::<ThreadInit>()) };
+            let rust_start = init.init();
+            rust_start();
+            // SAFETY: the thread's own values, at its end.
+            unsafe { crate::sys::thread_local::key::run_dtors() };
+            crate::rt::thread_cleanup();
+        }
+    }
+
+    pub fn join(self) {
+        let handle = self.handle;
+        crate::mem::forget(self);
+        // SAFETY: the handle has not been joined or detached.
+        while unsafe { sdk_thread_join(handle) } != 0 {
+            // The program is ending: a thread ends here, the main task ends the program.
+            crate::sys::pal::safe_point();
+            unreachable!("a safe point returned while the program is ending");
+        }
+    }
+}
+
+impl Drop for Thread {
+    fn drop(&mut self) {
+        // SAFETY: a handle that was not joined.
+        unsafe { sdk_thread_detach(self.handle) };
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    // The AROS images run on one CPU.
+    Ok(NonZero::new(1).unwrap())
+}
+
+pub fn current_os_id() -> Option<u64> {
+    // SAFETY: no precondition. The address of the task, unique while it lives.
+    Some(unsafe { sdk_task_id() } as u64)
+}
+
+pub fn yield_now() {
+    // SAFETY: no precondition.
+    unsafe { sdk_thread_yield() };
+    crate::sys::pal::safe_point();
+}
+
+pub fn set_name(_name: &CStr) {
+    // The name is given to the DOS process when it is made (`Thread::new`).
+}
+
+/// `EINTR` in the numbering of the AROS C library (NetBSD's).
+const EINTR: i32 = 4;
+
+/// The C `struct timespec` of AROS: a 32-bit `time_t` and a 64-bit `long`.
+#[repr(C)]
+struct CTimespec {
+    tv_sec: i32,
+    tv_nsec: i64,
+}
+
+unsafe extern "C" {
+    fn nanosleep(request: *const CTimespec, remaining: *mut CTimespec) -> i32;
+}
+
+pub fn sleep(dur: Duration) {
+    let mut remaining = dur;
+    while !remaining.is_zero() {
+        // `time_t` is 32 bits, so a longer sleep is made of several calls.
+        let secs = remaining.as_secs().min(i32::MAX as u64);
+        let nanos = if remaining.as_secs() > secs { 0 } else { remaining.subsec_nanos() };
+        let request = CTimespec { tv_sec: secs as i32, tv_nsec: nanos as i64 };
+        let mut left = CTimespec { tv_sec: 0, tv_nsec: 0 };
+        // SAFETY: both point to valid `timespec` values.
+        let result = unsafe { nanosleep(&request, &mut left) };
+        let asked = Duration::new(secs, nanos);
+        if result == 0 {
+            remaining -= asked;
+        } else if crate::io::Error::last_os_error().raw_os_error() == Some(EINTR) {
+            // Interrupted, for example by a break: sleep for what is left.
+            let unslept = Duration::new(
+                left.tv_sec.max(0) as u64,
+                (left.tv_nsec.clamp(0, 999_999_999)) as u32,
+            );
+            remaining = (remaining - asked) + unslept.min(asked);
+        } else {
+            break;
+        }
+    }
+    crate::sys::pal::safe_point();
+}
