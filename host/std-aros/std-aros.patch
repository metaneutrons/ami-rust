diff --git a/library/std/src/sys/io/error/aros.rs b/library/std/src/sys/io/error/aros.rs
new file mode 100644
index 0000000..00469fe
--- /dev/null
+++ b/library/std/src/sys/io/error/aros.rs
@@ -0,0 +1,127 @@
+use crate::ffi::{CStr, c_char, c_int};
+use crate::io::ErrorKind;
+use crate::{fmt, io};
+
+unsafe extern "C" {
+    // The C library keeps `errno` behind a link-library accessor. The two
+    // supported ABIs name it differently.
+    #[cfg_attr(target_abi = "abi11", link_name = "___geterrnoptr")]
+    #[cfg_attr(not(target_abi = "abi11"), link_name = "__stdc_geterrnoptr")]
+    fn errno_location() -> *mut c_int;
+
+    fn strerror(errnum: c_int) -> *const c_char;
+}
+
+// errno values of the AROS C library, which follows the NetBSD numbering.
+mod code {
+    pub const EPERM: i32 = 1;
+    pub const ENOENT: i32 = 2;
+    pub const EINTR: i32 = 4;
+    pub const EIO: i32 = 5;
+    pub const E2BIG: i32 = 7;
+    pub const ENOMEM: i32 = 12;
+    pub const EACCES: i32 = 13;
+    pub const EBUSY: i32 = 16;
+    pub const EEXIST: i32 = 17;
+    pub const EXDEV: i32 = 18;
+    pub const ENOTDIR: i32 = 20;
+    pub const EISDIR: i32 = 21;
+    pub const EINVAL: i32 = 22;
+    pub const ENFILE: i32 = 23;
+    pub const EMFILE: i32 = 24;
+    pub const ETXTBSY: i32 = 26;
+    pub const EFBIG: i32 = 27;
+    pub const ENOSPC: i32 = 28;
+    pub const ESPIPE: i32 = 29;
+    pub const EROFS: i32 = 30;
+    pub const EMLINK: i32 = 31;
+    pub const EPIPE: i32 = 32;
+    pub const EAGAIN: i32 = 35;
+    pub const EINPROGRESS: i32 = 36;
+    pub const EADDRINUSE: i32 = 48;
+    pub const EADDRNOTAVAIL: i32 = 49;
+    pub const ENETDOWN: i32 = 50;
+    pub const ENETUNREACH: i32 = 51;
+    pub const ECONNABORTED: i32 = 53;
+    pub const ECONNRESET: i32 = 54;
+    pub const ENOTCONN: i32 = 57;
+    pub const ETIMEDOUT: i32 = 60;
+    pub const ECONNREFUSED: i32 = 61;
+    pub const ELOOP: i32 = 62;
+    pub const ENAMETOOLONG: i32 = 63;
+    pub const EHOSTUNREACH: i32 = 65;
+    pub const ENOTEMPTY: i32 = 66;
+    pub const EDQUOT: i32 = 69;
+    pub const ESTALE: i32 = 70;
+    pub const ENOSYS: i32 = 78;
+    pub const ENOTSUP: i32 = 86;
+    pub const EDEADLK: i32 = 11;
+    pub const EOPNOTSUPP: i32 = 45;
+}
+
+#[inline]
+pub fn errno() -> i32 {
+    unsafe { *errno_location() as i32 }
+}
+
+#[inline]
+pub fn is_interrupted(errno: i32) -> bool {
+    errno == code::EINTR
+}
+
+pub fn decode_error_kind(errno: i32) -> io::ErrorKind {
+    use ErrorKind::*;
+    match errno {
+        code::E2BIG => ArgumentListTooLong,
+        code::EADDRINUSE => AddrInUse,
+        code::EADDRNOTAVAIL => AddrNotAvailable,
+        code::EBUSY => ResourceBusy,
+        code::ECONNABORTED => ConnectionAborted,
+        code::ECONNREFUSED => ConnectionRefused,
+        code::ECONNRESET => ConnectionReset,
+        code::EDEADLK => Deadlock,
+        code::EDQUOT => QuotaExceeded,
+        code::EEXIST => AlreadyExists,
+        code::EFBIG => FileTooLarge,
+        code::EHOSTUNREACH => HostUnreachable,
+        code::EINTR => Interrupted,
+        code::EINVAL => InvalidInput,
+        code::EISDIR => IsADirectory,
+        code::ELOOP => FilesystemLoop,
+        code::ENOENT => NotFound,
+        code::ENOMEM => OutOfMemory,
+        code::ENOSPC => StorageFull,
+        code::EMLINK => TooManyLinks,
+        code::ENAMETOOLONG => InvalidFilename,
+        code::ENETDOWN => NetworkDown,
+        code::ENETUNREACH => NetworkUnreachable,
+        code::ENOTCONN => NotConnected,
+        code::ENOTDIR => NotADirectory,
+        code::ENOTEMPTY => DirectoryNotEmpty,
+        code::EPIPE => BrokenPipe,
+        code::EROFS => ReadOnlyFilesystem,
+        code::ESPIPE => NotSeekable,
+        code::ESTALE => StaleNetworkFileHandle,
+        code::ETIMEDOUT => TimedOut,
+        code::ETXTBSY => ExecutableFileBusy,
+        code::EXDEV => CrossesDevices,
+        code::EINPROGRESS => InProgress,
+        code::EMFILE | code::ENFILE => TooManyOpenFiles,
+        code::EIO => InputOutputError,
+        code::EACCES | code::EPERM => PermissionDenied,
+        code::ENOSYS | code::ENOTSUP | code::EOPNOTSUPP => Unsupported,
+        code::EAGAIN => WouldBlock,
+        _ => Uncategorized,
+    }
+}
+
+// `strerror_r` is not exported by the ABI11 C library, so the shared
+// `strerror` is used. Its buffer is not thread safe, which is acceptable
+// while `std` runs on a single task.
+pub fn format_error(errno: i32, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    let text = unsafe { strerror(errno as c_int) };
+    if text.is_null() {
+        return f.write_str("unknown error");
+    }
+    write!(f, "{}", unsafe { CStr::from_ptr(text) }.display())
+}
