+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let flags = opts.access_mode()? | opts.creation_mode()?;
+        let path_for_times = path;
+        with_path(path, &|path| {
+            // SAFETY: `path` is a valid C string. The mode is only used when the file is created.
+            let fd = without_requesters(|| unsafe { c::open(path.as_ptr(), flags, 0o666 as c_int) });
+            cvt(fd, -1).map(|fd| File {
+                fd,
+                readable: opts.read,
+                writable: opts.write || opts.append,
+                append: opts.append,
+                beyond_end: Arc::new(AtomicU64::new(NO_POSITION)),
+                path: crate::sys::path::absolute(path_for_times).ok().map(Arc::new),
+                pending_date: Arc::new(AtomicU64::new(0)),
+            })
+        })
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        let mut stat = crate::mem::MaybeUninit::<Stat>::zeroed();
+        // SAFETY: `fd` is open for as long as `self` exists, and `stat` is writable.
+        cvt(unsafe { c::fstat64(self.fd, stat.as_mut_ptr()) }, -1)?;
+        // SAFETY: zeroed, and then written by the C library; every field is an integer.
+        Ok(FileAttr { stat: unsafe { stat.assume_init() } })
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        // SAFETY: `fd` is open for as long as `self` exists.
+        cvt(unsafe { c::fsync(self.fd) }, -1).map(drop)
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        // The C library has no `fdatasync`; `fsync` does at least what it asks for.
+        self.fsync()
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(io::Error::UNSUPPORTED_PLATFORM))
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(io::Error::UNSUPPORTED_PLATFORM))
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        self.pending_date.store(0, Ordering::Relaxed);
+        let size = i64::try_from(size).map_err(|_| io::Error::from_raw_os_error(EINVAL))?;
+        // SAFETY: `fd` is open for as long as `self` exists.
+        cvt(unsafe { c::ftruncate(self.fd, size) }, -1).map(drop)
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        // DOS does not enforce the access mode of a handle, so it is enforced here.
+        if !self.readable {
+            return Err(io::Error::from_raw_os_error(EBADF));
+        }
+        // After a seek past the end there is nothing to read.
+        if self.beyond_end.load(Ordering::Relaxed) != NO_POSITION {
+            return Ok(0);
+        }
+        let count = buf.len().min(IO_LIMIT);
+        // SAFETY: `buf` is valid for `count` bytes.
+        let n = unsafe { c::read(self.fd, buf.as_mut_ptr().cast(), count) };
+        cvt(n, -1).map(|n| n as usize)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        crate::io::default_read_vectored(|b| self.read(b), bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        crate::io::default_read_buf(|buf| self.read(buf), cursor)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.writable {
+            return Err(io::Error::from_raw_os_error(EBADF));
+        }
+        self.pending_date.store(0, Ordering::Relaxed);
+        if self.append {
+            // The C library only moves to the end when the file is opened, so a handle that
+            // was moved with `seek` would overwrite. Append means that every write goes to the end.
+            self.beyond_end.store(NO_POSITION, Ordering::Relaxed);
+            self.lseek(0, SEEK_END)?;
+        } else {
+            self.materialise_position()?;
+        }
+        let count = buf.len().min(IO_LIMIT);
+        // SAFETY: `buf` is valid for `count` bytes.
+        let n = unsafe { c::write(self.fd, buf.as_ptr().cast(), count) };
+        cvt(n, -1).map(|n| n as usize)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        crate::io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    fn lseek(&self, offset: i64, whence: c_int) -> io::Result<u64> {
+        // SAFETY: `fd` is open for as long as `self` exists.
+        cvt(unsafe { c::lseek(self.fd, offset, whence) }, -1).map(|position| position as u64)
+    }
+
+    /// The position of the handle, which after a seek past the end is the remembered one.
+    fn position(&self) -> io::Result<u64> {
+        match self.beyond_end.load(Ordering::Relaxed) {
+            NO_POSITION => self.lseek(0, SEEK_CUR),
+            position => Ok(position),
+        }
+    }
+
+    /// Makes a remembered position real before a write: the file is extended with zeros up to
+    /// it, as a write after a seek past the end does on other systems.
+    fn materialise_position(&self) -> io::Result<()> {
+        let position = self.beyond_end.load(Ordering::Relaxed);
+        if position == NO_POSITION {
+            return Ok(());
+        }
+        let size = self.lseek(0, SEEK_END)?;
+        if position > size {
+            // SAFETY: `fd` is open for as long as `self` exists.
+            cvt(unsafe { c::ftruncate(self.fd, position as i64) }, -1)?;
+        }
+        self.lseek(position as i64, SEEK_SET)?;
+        self.beyond_end.store(NO_POSITION, Ordering::Relaxed);
+        Ok(())
+    }
+
+    /// Seeks. A seek past the end of the file is **not** passed to the C library. For a seek past
+    /// the end the C library extends the file at once, even for a handle that can only read, so a
+    /// read-only seek would change the file, and on ABI-v11 it extends by the wrong amount
+    /// (position plus file size). The position is remembered instead, reads there return 0, and
+    /// the next write extends the file with zeros. Seeks inside the file, and from the end to
+    /// before it, are correct in the C library on both ABIs and go straight to it.
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let invalid = || io::Error::from_raw_os_error(EINVAL);
+        let target = match pos {
+            SeekFrom::End(offset) if offset <= 0 => {
+                let position = self.lseek(offset, SEEK_END)?;
+                self.beyond_end.store(NO_POSITION, Ordering::Relaxed);
+                return Ok(position);
+            }
+            SeekFrom::End(offset) => {
+                self.lseek(0, SEEK_END)?.checked_add(offset as u64).ok_or_else(invalid)?
+            }
+            SeekFrom::Start(offset) => offset,
+            SeekFrom::Current(0) => return self.position(),
+            SeekFrom::Current(offset) => {
+                self.position()?.checked_add_signed(offset).ok_or_else(invalid)?
+            }
+        };
+        if target > i64::MAX as u64 {
+            return Err(invalid());
+        }
+        let size = self.lseek(0, SEEK_END)?;
+        if target <= size {
+            self.beyond_end.store(NO_POSITION, Ordering::Relaxed);
+            self.lseek(target as i64, SEEK_SET)
+        } else {
+            self.beyond_end.store(target, Ordering::Relaxed);
+            Ok(target)
+        }
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(self.file_attr().map(|attr| attr.size()))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        self.position()
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        // SAFETY: `fd` is open for as long as `self` exists.
+        cvt(unsafe { c::dup(self.fd) }, -1).map(|fd| File {
+            fd,
+            readable: self.readable,
+            writable: self.writable,
+            append: self.append,
+            beyond_end: Arc::clone(&self.beyond_end),
+            path: self.path.clone(),
