@@ -0,0 +1,32 @@
+//! The arguments of an AROS program are the `argc` and `argv` that the C
+//! start-up stores in `__argc` and `__argv` before it calls the program. The
+//! first one is the program name, as in `Context::args` of the `aros` crate.
+
+#![allow(dead_code)]
+
+pub use super::common::Args;
+use crate::ffi::{CStr, OsString, c_char, c_int};
+
+unsafe extern "C" {
+    static __argc: c_int;
+    static __argv: *const *const c_char;
+}
+
+pub fn args() -> Args {
+    // SAFETY: the C start-up sets both before the program runs, and they stay
+    // valid until it ends.
+    let (argc, argv) = unsafe { (__argc, __argv) };
+    let mut vec = Vec::with_capacity(argc.max(0) as usize);
+    if !argv.is_null() {
+        for i in 0..argc.max(0) as usize {
+            let ptr = unsafe { argv.add(i).read() };
+            if ptr.is_null() {
+                break;
+            }
+            let bytes = unsafe { CStr::from_ptr(ptr) }.to_bytes().to_vec();
+            // SAFETY: the bytes are an argument of this platform.
+            vec.push(unsafe { OsString::from_encoded_bytes_unchecked(bytes) });
+        }
+    }
+    Args::new(vec)
+}
