+    pub fn file_type(&self) -> io::Result<FileType> {
+        match self.d_type {
+            DT_DIR => Ok(FileType { mode: S_IFDIR }),
+            DT_REG => Ok(FileType { mode: S_IFREG }),
+            DT_LNK => Ok(FileType { mode: S_IFLNK }),
+            _ => lstat(&self.path()).map(|attr| attr.file_type()),
+        }
+    }
+}
