@@ -0,0 +1,46 @@
+//! A futex on AROS, made by the native bridge from Exec signals (`sdk_futex_wait`, `sdk_futex_wake`).
+//! Every wait is also a safe point: when the program is ending, a thread ends there and the main task
+//! ends the program (see `sys::pal::aros::safe_point`).
+
+use crate::sync::atomic::Atomic;
+use crate::time::Duration;
+
+/// An atomic for use as a futex that is at least 32-bits but may be larger
+pub type Futex = Atomic<Primitive>;
+/// Must be the underlying type of Futex
+pub type Primitive = u32;
+
+/// An atomic for use as a futex that is at least 8-bits but may be larger.
+pub type SmallFutex = Atomic<SmallPrimitive>;
+/// Must be the underlying type of SmallFutex
+pub type SmallPrimitive = u32;
+
+unsafe extern "C" {
+    fn sdk_futex_wait(address: *mut u32, expected: u32, timeout_us: i64) -> i32;
+    fn sdk_futex_wake(address: *mut u32, count: i32) -> i32;
+}
+
+/// Waits while `futex` holds `expected`. Returns `false` on a timeout; a return can be spurious.
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    crate::sys::pal::safe_point();
+    let timeout_us = match timeout {
+        None => -1,
+        Some(d) => i64::try_from(d.as_micros()).unwrap_or(i64::MAX),
+    };
+    // SAFETY: the address is that of a live atomic for the whole call.
+    let timed_out = unsafe { sdk_futex_wait(futex.as_ptr(), expected, timeout_us) } != 0;
+    crate::sys::pal::safe_point();
+    !timed_out
+}
+
+#[inline]
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    // SAFETY: the address is only compared, never dereferenced, by the bridge.
+    unsafe { sdk_futex_wake(futex.as_ptr(), 1) > 0 }
+}
+
+#[inline]
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    // SAFETY: as above.
+    unsafe { sdk_futex_wake(futex.as_ptr(), i32::MAX) };
+}
