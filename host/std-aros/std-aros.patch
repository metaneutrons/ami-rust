+pub fn unlink(p: &Path) -> io::Result<()> {
+    with_path(p, &|p| {
+        // The C library's `unlink` is `DeleteFile`, which also deletes an empty directory.
+        if let Ok(attr) = stat_with(p, c::lstat64) {
+            if attr.file_type().is_dir() {
+                return Err(io::Error::from_raw_os_error(EISDIR));
+            }
+        }
+        // SAFETY: `p` is a valid C string.
+        let result = without_requesters(|| unsafe { c::unlink(p.as_ptr()) });
+        if result != -1 {
+            return Ok(());
+        }
+        let error = last_error();
+        // On ABI-v1 deleting a file that is open fails with "object not found", although the
+        // file is there. Code that treats `NotFound` from `remove_file` as "already gone" would
+        // then leave the file behind, so a file that can still be opened is reported as busy.
+        if error.kind() == io::ErrorKind::NotFound {
+            let still_there = without_requesters(|| unsafe { c::open(p.as_ptr(), flag::O_RDONLY) });
+            if still_there != -1 {
+                // SAFETY: the descriptor was just opened here.
+                unsafe { c::close(still_there) };
+                return Err(io::Error::from_raw_os_error(EBUSY));
+            }
+        }
+        Err(error)
+    })
+}
+
+/// `rename` of the C library, which is only called for a destination that does not exist: for one that
+/// exists it deletes the destination first, and on a volume that ignores case that can be the source
+/// itself. ABI-v1 sets no error for a failed rename and ABI-v11 sets a wrong one for some, so the
+/// cause is found from the state of the file system.
+fn c_rename(old: &Path, new: &Path) -> io::Result<()> {
+    let _clib = ClibLock::new();
+    let result = with_path(old, &|o| {
+        with_path(new, &|n| {
+            // SAFETY: both are valid C strings.
+            Ok(without_requesters(|| unsafe { c::rename(o.as_ptr(), n.as_ptr()) }))
+        })
+    })?;
+    if result == 0 {
+        return Ok(());
+    }
+    let code = errno();
+    if lstat(old).is_err() {
+        return Err(io::Error::from_raw_os_error(ENOENT));
+    }
+    let new_dos = crate::sys::path::to_dos_path(new).into_owned();
+    let parent = new_dos.parent().filter(|p| !p.as_os_str().is_empty());
+    if let Some(parent) = parent {
+        if lstat(parent).is_err() {
+            return Err(io::Error::from_raw_os_error(ENOENT));
+        }
+    }
+    let here = Path::new("");
+    let (Ok(from), Ok(to)) = (dos_name(old), dos_name(parent.unwrap_or(here))) else { return Err(error_from(code)) };
+    if from.components().next() != to.components().next() {
+        return Err(io::Error::from_raw_os_error(EXDEV));
+    }
+    if to.starts_with(&from) {
+        return Err(io::Error::from_raw_os_error(EINVAL));
+    }
+    Err(error_from(code))
+}
+
+fn error_from(code: i32) -> io::Error {
+    if code == 0 { io::const_error!(io::ErrorKind::Other, "the C library failed without an error code") } else { io::Error::from_raw_os_error(code) }
+}
+
+/// A name that does not exist yet, in the directory of `path`.
+fn name_beside(path: &Path) -> io::Result<PathBuf> {
+    static COUNTER: crate::sync::atomic::AtomicU32 = crate::sync::atomic::AtomicU32::new(0);
+    let dos = crate::sys::path::to_dos_path(path).into_owned();
+    let dir = dos.parent().map(Path::to_path_buf).unwrap_or_default();
+    for _ in 0..1000 {
+        let n = COUNTER.fetch_add(1, Ordering::Relaxed);
+        let candidate = dir.join(format!(".ami-rust-rename-{n}"));
+        match lstat(&candidate) {
+            Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(candidate),
+            _ => {}
+        }
+    }
+    Err(io::const_error!(io::ErrorKind::AlreadyExists, "no free temporary name for the rename"))
+}
+
+/// Renames without ever letting the C library delete the destination. For a destination that exists,
+/// the destination is first moved aside to a temporary name, then the source takes its name, and then
+/// the old destination is deleted; if the second step fails, the destination gets its name back.
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    let _clib = ClibLock::new();
+    let old_attr = lstat(old)?;
+    let new_attr = match lstat(new) {
+        Ok(attr) => attr,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return c_rename(old, new),
+        Err(e) => return Err(e),
+    };
+    // The same object, also under a name that differs in case only. The C library would delete it.
+    if let (Ok(a), Ok(b)) = (dos_name(old), dos_name(new)) {
+        if a == b {
+            let old_dos = crate::sys::path::to_dos_path(old).into_owned();
+            let new_dos = crate::sys::path::to_dos_path(new).into_owned();
+            if old_dos.file_name() == new_dos.file_name() {
+                return Ok(());
+            }
+            let aside = name_beside(new)?;
+            c_rename(old, &aside)?;
+            return c_rename(&aside, new).inspect_err(|_| {
+                let _ = c_rename(&aside, old);
+            });
+        }
+    }
+    match (old_attr.file_type().is_dir(), new_attr.file_type().is_dir()) {
+        (true, false) => return Err(io::Error::from_raw_os_error(ENOTDIR)),
+        (false, true) => return Err(io::Error::from_raw_os_error(EISDIR)),
+        (true, true) => {
+            if with_path(new, &|n| Ok(has_entries(n)))? {
+                return Err(io::Error::from_raw_os_error(ENOTEMPTY));
+            }
+        }
+        (false, false) => {}
+    }
+    let aside = name_beside(new)?;
+    c_rename(new, &aside)?;
+    if let Err(e) = c_rename(old, new) {
+        let _ = c_rename(&aside, new);
+        return Err(e);
+    }
+    // The old destination. DOS renames a file that is open but does not delete it; then both renames
+    // are undone, so that nothing is left under the temporary name.
+    let deleted = with_path(&aside, &|a| {
+        // SAFETY: `a` is a valid C string.
+        Ok(without_requesters(|| unsafe { c::unlink(a.as_ptr()) }))
+    })?;
+    if deleted != 0 {
+        // The file exists (it was just renamed), so "not found", which ABI-v1 reports for an open file,
+        // and no error at all mean that it is in use.
+        let error = match errno() {
+            0 | ENOENT => io::Error::from_raw_os_error(EBUSY),
+            code => io::Error::from_raw_os_error(code),
+        };
+        let _ = c_rename(new, old);
+        let _ = c_rename(&aside, new);
+        return Err(error);
+    }
+    Ok(())
+}
+
+pub fn set_perm(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    with_path(p, &|p| {
+        // SAFETY: `p` is a valid C string.
+        cvt(without_requesters(|| unsafe { c::chmod(p.as_ptr(), perm.mode as c_int) }), -1).map(drop)
+    })
+}
+
+pub fn set_perm_nofollow(_p: &Path, _perm: FilePermissions) -> io::Result<()> {
+    unsupported()
+}
+
+/// The first second that a DOS date can hold: 1 January 1978.
+const DOS_EPOCH: i64 = 252_460_800;
+
+/// Sets the date of a file or directory. DOS keeps one date, so only the modification time can be
+/// set, to a whole second from 1978 to 2106.
+pub fn set_times(p: &Path, times: FileTimes) -> io::Result<()> {
+    let Some(modified) = times.modified else {
+        return match times.accessed {
+            Some(_) => Err(io::const_error!(
+                io::ErrorKind::Unsupported,
+                "DOS keeps one date per file; set the modification time",
+            )),
+            None => Ok(()),
+        };
+    };
+    let seconds = modified.unix_seconds();
+    if !(DOS_EPOCH..=u32::MAX as i64).contains(&seconds) {
+        return Err(io::const_error!(io::ErrorKind::InvalidInput, "a DOS date is between 1978 and 2106"));
+    }
+    // `struct timeval`: a 32-bit `time_t` and 32-bit microseconds; the C library reads the second one.
+    let tv = [[seconds as u32 as i32, 0i32]; 2];
+    with_path(p, &|p| {
+        // SAFETY: `p` is a valid C string, `tv` two timevals.
+        cvt(without_requesters(|| unsafe { c::utimes(p.as_ptr(), tv.as_ptr()) }), -1).map(drop)
+    })
+}
+
+pub fn set_times_nofollow(_p: &Path, _times: FileTimes) -> io::Result<()> {
+    unsupported()
+}
+
+fn has_entries(path: &CStr) -> bool {
+    // SAFETY: `path` is a valid C string.
+    let stream = without_requesters(|| unsafe { c::opendir(path.as_ptr()) });
+    if stream.is_null() {
+        return false;
+    }
+    let stream = DirStream(stream);
+    loop {
+        // SAFETY: the stream is open until `stream` is dropped.
+        let entry = unsafe { c::readdir64(stream.0) };
+        if entry.is_null() {
+            return false;
+        }
+        // SAFETY: a non-null entry has a C string for a name.
+        let name = unsafe { CStr::from_ptr((*entry).d_name.as_ptr()) }.to_bytes();
+        if name != b"." && name != b".." {
+            return true;
+        }
+    }
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    with_path(p, &|p| {
+        // The C library's `rmdir` is `DeleteFile`, which would delete a file.
+        let attr = stat_with(p, c::lstat64)?;
+        if !attr.file_type().is_dir() {
+            return Err(io::Error::from_raw_os_error(ENOTDIR));
+        }
+        // SAFETY: `p` is a valid C string.
+        if without_requesters(|| unsafe { c::rmdir(p.as_ptr()) }) != -1 {
+            return Ok(());
+        }
+        let error = last_error();
+        // Deleting a directory that is not empty fails on ABI-v1 without setting an error, so `errno`
+        // is whatever an earlier call left (0, or "not found"). A directory that has an entry is
+        // therefore reported as not empty, whatever `errno` says.
+        if has_entries(p) {
+            return Err(io::Error::from_raw_os_error(ENOTEMPTY));
+        }
+        Err(error)
+    })
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    unsupported()
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn link(_src: &Path, _dst: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+fn stat_with(
+    path: &CStr,
+    call: unsafe extern "C" fn(*const c_char, *mut Stat) -> c_int,
+) -> io::Result<FileAttr> {
+    let mut stat = crate::mem::MaybeUninit::<Stat>::zeroed();
+    // SAFETY: `path` is a valid C string and `stat` is writable.
+    cvt(without_requesters(|| unsafe { call(path.as_ptr(), stat.as_mut_ptr()) }), -1)?;
+    // SAFETY: zeroed, and then written by the C library; every field is an integer.
+    Ok(FileAttr { stat: unsafe { stat.assume_init() } })
+}
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    with_path(p, &|p| stat_with(p, c::stat64))
+}
+
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    with_path(p, &|p| stat_with(p, c::lstat64))
+}
+
+/// The full name of a path from DOS: the volume by its name, assigns and the current directory resolved.
+/// The path is given in DOS form; empty is the current directory.
+fn dos_name(p: &Path) -> io::Result<PathBuf> {
+    unsafe extern "C" {
+        /// Writes the full name of the object at `path` and returns 0, or a DOS error code.
+        fn sdk_path_name(path: *const c_char, buf: *mut c_char, size: usize) -> crate::ffi::c_long;
+    }
+    let dos = crate::sys::path::to_dos_path(p).into_owned();
+    run_path_with_cstr(&dos, &|path| {
+        let mut size = 256;
+        loop {
+            let mut buf = vec![0u8; size];
+            // SAFETY: `path` is a C string and `buf` has `size` bytes.
+            let code = without_requesters(|| unsafe { sdk_path_name(path.as_ptr(), buf.as_mut_ptr().cast(), size) });
+            match code {
+                0 => {
+                    let len = buf.iter().position(|&b| b == 0).unwrap_or(size);
+                    buf.truncate(len);
+                    // SAFETY: the name that DOS gave, as `std` stores every path.
+                    return Ok(PathBuf::from(unsafe { OsString::from_encoded_bytes_unchecked(buf) }));
+                }
+                // ERROR_LINE_TOO_LONG
+                120 if size < 1 << 20 => size *= 4,
+                // ERROR_OBJECT_NOT_FOUND, ERROR_DEVICE_NOT_MOUNTED, ERROR_DIR_NOT_FOUND
+                205 | 218 | 204 => return Err(io::Error::from_raw_os_error(ENOENT)),
+                code => return Err(io::Error::from_raw_os_error(1000 + code as i32)),
+            }
+        }
+    })
+}
+
+/// The C library's `realpath` fails for every path (it starts with `open(".")`, and DOS has no `.`),
+/// so DOS is asked for the name instead. A file that is open for writing cannot be locked; its name is
+/// that of its directory and its own name.
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    if p.as_os_str().is_empty() {
+        return Err(io::Error::from_raw_os_error(ENOENT));
+    }
+    match dos_name(p) {
+        Err(e) if e.raw_os_error() == Some(1000 + 202) => {
+            let dos = crate::sys::path::to_dos_path(p).into_owned();
+            let name = dos.file_name().ok_or(e)?.to_owned();
+            let dir = dos.parent().map(Path::to_path_buf).unwrap_or_default();
+            Ok(dos_name(&dir)?.join(name))
+        }
+        result => result,
+    }
+}
+
