diff --git a/library/std/src/sys/process/aros.rs b/library/std/src/sys/process/aros.rs
new file mode 100644
index 0000000..b1b8e38
--- /dev/null
+++ b/library/std/src/sys/process/aros.rs
@@ -0,0 +1,864 @@
+//! Child programs on AROS: `process::Command` over `LoadSeg` and `CreateNewProc`.
+//!
+//! A command runs as a DOS process of its own. `spawn` makes a thread of `std` for it (a DOS process too),
+//! which sets its current directory and its local variables and then calls the bridge function
+//! `sdk_proc_run`: that loads the program, starts it with `CreateNewProc` (the arguments in `NP_Arguments`,
+//! no shell), waits until the process has gone and returns its return code. `Process` is the state that the
+//! thread and the parent share.
+//!
+//! What this gives, and what it does not:
+//!
+//! - `program` is looked for as it is and, when it has no volume, in `C:`. The command path of the shell
+//!   is not searched. A program that is not found is `NotFound` from `spawn`.
+//! - The arguments are quoted in the way that the C start-up of AROS reads them (see `quote`). No shell
+//!   reads the line, so an argument cannot add a redirection or a second command, and a quote or a
+//!   semicolon in an argument is text.
+//! - The standard streams are those of the parent unless the command says otherwise.
+//! - `current_dir` is the directory the child starts in. `env` sets and removes DOS variables for the
+//!   child only, as the local variables of its process; `env_clear` is `Unsupported`.
+//! - `Stdio::piped()` is a file in `T:`: what the child writes can be read when it has ended (a read
+//!   waits for that), and what is written to the child's input is given to it when the input is closed,
+//!   which is when it starts. There is no pipe that both sides use at once.
+//! - The exit status is the return code of the program (0, 5 warn, 10 error, 20 fail, or what it returns).
+//!   There are no signals: `kill` is `Unsupported` while the child runs.
+//! - A `File` is not accepted as a standard stream of a child (DOS cannot be given a descriptor of the C
+//!   library); that is `Unsupported`.
+
+use super::env::{CommandEnv, CommandEnvs, CommandResolvedEnvs};
+pub use crate::ffi::OsString as EnvKey;
+use crate::ffi::{CString, OsStr, OsString};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, Write};
+use crate::num::NonZero;
+use crate::path::{Path, PathBuf};
+use crate::process::StdioPipes;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::sync::{Arc, Condvar, Mutex};
+use crate::sys::fs::File;
+use crate::{fmt, fs};
+
+unsafe extern "C" {
+    /// Stores the standard input, output and error handles of the calling process.
+    fn sdk_proc_streams(input: *mut usize, output: *mut usize, error: *mut usize);
+    /// Loads `program`, starts it with `arguments` as a process of its own and waits for it; stores its
+    /// return code. Returns 0 or a DOS error code. A stream is a file name, or the handle when the name is
+    /// `NULL`.
+    fn sdk_proc_run(
+        program: *const crate::ffi::c_char,
+        arguments: *const crate::ffi::c_char,
+        input: *const crate::ffi::c_char,
+        output: *const crate::ffi::c_char,
+        error: *const crate::ffi::c_char,
+        input_handle: usize,
+        output_handle: usize,
+        error_handle: usize,
+        rc: *mut i32,
+    ) -> crate::ffi::c_long;
+    fn sdk_task_id() -> usize;
+}
+
+static NEXT_ID: AtomicU32 = AtomicU32::new(1);
+static NEXT_FILE: AtomicU32 = AtomicU32::new(0);
+
+////////////////////////////////////////////////////////////////////////////////
+// Command
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Command {
+    program: OsString,
+    args: Vec<OsString>,
+    env: CommandEnv,
+
+    cwd: Option<OsString>,
+    stdin: Option<Stdio>,
+    stdout: Option<Stdio>,
+    stderr: Option<Stdio>,
+}
+
+#[derive(Debug)]
+pub enum Stdio {
+    Inherit,
+    Null,
+    MakePipe,
+    ParentStdout,
+    ParentStderr,
+    #[allow(dead_code)] // This variant exists only for the Debug impl
+    InheritFile(File),
+    /// The captured output of another child, which this child reads as its input.
+    Captured(Arc<Shared>, Arc<TempFile>),
+}
+
+/// A file in `T:` that is removed when the last reference goes.
+#[derive(Debug)]
+pub struct TempFile {
+    path: String,
+}
+
+impl TempFile {
+    fn create() -> io::Result<(Arc<TempFile>, fs::File)> {
+        loop {
+            let n = NEXT_FILE.fetch_add(1, Ordering::Relaxed);
+            let path = format!("T:ami-rust-proc-{:x}-{n}", unsafe { sdk_task_id() });
+            match fs::OpenOptions::new().write(true).create_new(true).open(&path) {
+                Ok(file) => return Ok((Arc::new(TempFile { path }), file)),
+                Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,
+                Err(e) => return Err(e),
+            }
+        }
+    }
+}
+
+impl Drop for TempFile {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.path);
+    }
+}
+
+impl Command {
+    pub fn new(program: &OsStr) -> Command {
+        Command {
+            program: program.to_owned(),
+            args: vec![program.to_owned()],
+            env: Default::default(),
+            cwd: None,
+            stdin: None,
+            stdout: None,
+            stderr: None,
+        }
+    }
+
+    pub fn arg(&mut self, arg: &OsStr) {
+        self.args.push(arg.to_owned());
+    }
+
+    pub fn env_mut(&mut self) -> &mut CommandEnv {
+        &mut self.env
+    }
+
+    pub fn cwd(&mut self, dir: &OsStr) {
+        self.cwd = Some(dir.to_owned());
+    }
+
+    pub fn stdin(&mut self, stdin: Stdio) {
+        self.stdin = Some(stdin);
+    }
+
+    pub fn stdout(&mut self, stdout: Stdio) {
+        self.stdout = Some(stdout);
+    }
+
+    pub fn stderr(&mut self, stderr: Stdio) {
+        self.stderr = Some(stderr);
+    }
+
+    pub fn get_program(&self) -> &OsStr {
+        &self.program
+    }
+
+    pub fn get_args(&self) -> CommandArgs<'_> {
+        let mut iter = self.args.iter();
+        iter.next();
+        CommandArgs { iter }
+    }
+
+    pub fn get_envs(&self) -> CommandEnvs<'_> {
+        self.env.iter()
+    }
+
+    pub fn get_env_clear(&self) -> bool {
+        self.env.does_clear()
+    }
+
+    pub fn get_resolved_envs(&self) -> CommandResolvedEnvs {
+        CommandResolvedEnvs::new(self.env.capture())
+    }
+
+    pub fn get_current_dir(&self) -> Option<&Path> {
+        self.cwd.as_ref().map(|cs| Path::new(cs))
+    }
+
+    pub fn spawn(&mut self, default: Stdio, needs_stdin: bool) -> io::Result<(Process, StdioPipes)> {
+        if self.env.does_clear() {
+            return Err(io::const_error!(io::ErrorKind::Unsupported, "a child cannot start with an empty environment on AROS"));
+        }
+        let program = self.resolve()?;
+        let program = CString::new(program.as_encoded_bytes()).map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "a program name has a nul byte"))?;
+        // The program gets the arguments as one string that ends with a line feed, in the quoting of DOS.
+        let mut arguments = Vec::new();
+        for arg in &self.args[1..] {
+            if !arguments.is_empty() {
+                arguments.push(b' ');
+            }
+            quote(arg.as_encoded_bytes(), &mut arguments)?;
+        }
+        arguments.push(b'\n');
+        let arguments = CString::new(arguments).map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "an argument has a nul byte"))?;
+        if let Some(dir) = &self.cwd {
+            if !fs::metadata(dir)?.is_dir() {
+                return Err(io::const_error!(io::ErrorKind::NotADirectory, "the directory of the child is not a directory"));
+            }
+        }
+        let env: Vec<(OsString, Option<OsString>)> = self.env.iter().map(|(k, v)| (k.to_owned(), v.map(|v| v.to_owned()))).collect();
+
+        let default_in = if needs_stdin { default_clone(&default) } else { Stdio::Null };
+        let stdin = self.stdin.take().unwrap_or(default_in);
+        let stdout = self.stdout.take().unwrap_or_else(|| default_clone(&default));
+        let stderr = self.stderr.take().unwrap_or_else(|| default_clone(&default));
+
+        let shared = Arc::new(Shared::new());
+        let mut pipes = StdioPipes { stdin: None, stdout: None, stderr: None };
+        let mut after = None;
+
+        // The handles of the parent that a stream without a name of its own uses.
+        let (mut parent_in, mut parent_out, mut parent_err) = (0usize, 0usize, 0usize);
+        // SAFETY: stores three handles.
+        unsafe { sdk_proc_streams(&mut parent_in, &mut parent_out, &mut parent_err) };
+
+        let (in_name, in_handle) = match stdin {
+            Stdio::Inherit | Stdio::ParentStdout | Stdio::ParentStderr => (None, parent_in),
+            Stdio::Null => (Some("NIL:".to_string()), 0),
+            Stdio::MakePipe => {
+                let (temp, file) = TempFile::create()?;
+                let name = temp.path.clone();
+                // The file stays until the child has ended, whatever happens to the pipe.
+                shared.keep(temp.clone());
+                pipes.stdin = Some(ChildPipe::input(shared.clone(), temp, file));
+                (Some(name), 0)
+            }
+            Stdio::Captured(source, temp) => {
+                after = Some(source);
+                let name = temp.path.clone();
+                shared.keep(temp);
+                (Some(name), 0)
+            }
+            Stdio::InheritFile(_) => return Err(io::Error::UNSUPPORTED_PLATFORM),
+        };
+        let (out_name, out_handle, out_temp) = output_stream(stdout, parent_out, parent_out, parent_err)?;
+        let (err_name, err_handle, err_temp) = output_stream(stderr, parent_err, parent_out, parent_err)?;
+        if let Some(temp) = out_temp {
+            pipes.stdout = Some(ChildPipe::output(shared.clone(), temp));
+        }
+        if let Some(temp) = err_temp {
+            pipes.stderr = Some(ChildPipe::output(shared.clone(), temp));
+        }
+
+        let launch = Launch {
+            program,
+            arguments,
+            cwd: self.cwd.clone(),
+            env,
+            stdin: in_name,
+            stdout: out_name,
+            stderr: err_name,
+            handles: [in_handle, out_handle, err_handle],
+            after,
+        };
+        *shared.launch.lock().unwrap() = Some(launch);
+        // A child whose input is a pipe starts when that is closed; every other child starts now.
+        if pipes.stdin.is_none() {
+            shared.start()?;
+        }
+        Ok((Process { shared, status: None }, pipes))
+    }
+
+    /// Where the program is: as given, or in `C:` when it names no volume. This is the lookup of the
+    /// parent; the command path of the shell is not searched.
+    fn resolve(&self) -> io::Result<OsString> {
+        let program = Path::new(&self.program);
+        let name = self.program.as_encoded_bytes();
+        let has_volume = name.contains(&b':');
+        let mut candidates: Vec<PathBuf> = Vec::new();
+        match (&self.cwd, has_volume) {
+            (Some(dir), false) => candidates.push(Path::new(dir).join(program)),
+            _ => candidates.push(program.to_path_buf()),
+        }
+        if !has_volume && !name.contains(&b'/') {
+            let mut c = OsString::from("C:");
+            c.push(&self.program);
+            candidates.push(PathBuf::from(c));
+        }
+        // A candidate that cannot be examined for another reason than that it is not there (a file that is
+        // in use, say) is not "not found": that error is returned when no other candidate is.
+        let mut other: Option<io::Error> = None;
+        for candidate in candidates {
+            match fs::metadata(&candidate) {
+                Ok(m) if m.is_file() => {
+                    // A program found in the directory of `cwd` is passed as it was found: the child
+                    // starts in that directory and finds it by the name that was given.
+                    return Ok(if self.cwd.is_some() && !has_volume && !candidate.starts_with("C:") { self.program.clone() } else { candidate.into_os_string() });
+                }
+                Ok(_) => {}
+                Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+                Err(e) => other = Some(e),
+            }
+        }
+        if let Some(e) = other {
+            return Err(e);
+        }
+        Err(io::const_error!(io::ErrorKind::NotFound, "the program was not found"))
+    }
+}
+
+fn default_clone(default: &Stdio) -> Stdio {
+    match default {
+        Stdio::Inherit => Stdio::Inherit,
+        Stdio::Null => Stdio::Null,
+        Stdio::MakePipe => Stdio::MakePipe,
+        Stdio::ParentStdout => Stdio::ParentStdout,
+        Stdio::ParentStderr => Stdio::ParentStderr,
+        _ => Stdio::Inherit,
+    }
+}
+
+/// Where one output stream of the child goes: the name of a file (or none), the handle of the parent that
+/// it uses when it has no name, and the file to read it from when it is a pipe. `own` is the handle of
+/// the parent's stream of the same kind, `stdout` and `stderr` those of the parent's two streams.
+fn output_stream(stdio: Stdio, own: usize, stdout: usize, stderr: usize) -> io::Result<(Option<String>, usize, Option<Arc<TempFile>>)> {
+    Ok(match stdio {
+        Stdio::Inherit => (None, own, None),
+        Stdio::Null => (Some("NIL:".to_string()), 0, None),
+        Stdio::MakePipe => {
+            let (temp, file) = TempFile::create()?;
+            drop(file);
+            (Some(temp.path.clone()), 0, Some(temp))
+        }
+        Stdio::ParentStdout => (None, stdout, None),
+        Stdio::ParentStderr => (None, stderr, None),
+        Stdio::InheritFile(_) | Stdio::Captured(..) => return Err(io::Error::UNSUPPORTED_PLATFORM),
+    })
+}
+
+/// Quotes one word of the argument string in the way that the C start-up of AROS reads it (the quoting of
+/// DOS). A word of plain characters is left as it is; any other is put in double quotes, with `*` (the
+/// escape of DOS) before a `*` and a `"`, and a line feed or carriage return written `*N` and `*R`.
+fn quote(word: &[u8], out: &mut Vec<u8>) -> io::Result<()> {
+    if word.contains(&0) {
+        return Err(io::const_error!(io::ErrorKind::InvalidInput, "a command line has a nul byte"));
+    }
+    let plain = !word.is_empty() && word.iter().all(|b| b.is_ascii_alphanumeric() || b"_-./:+=,@%".contains(b));
+    if plain {
+        out.extend_from_slice(word);
+        return Ok(());
+    }
+    out.push(b'"');
+    for &b in word {
+        match b {
+            b'*' => out.extend_from_slice(b"**"),
+            b'"' => out.extend_from_slice(b"*\""),
+            b'\n' => out.extend_from_slice(b"*N"),
+            b'\r' => out.extend_from_slice(b"*R"),
+            _ => out.push(b),
+        }
+    }
+    out.push(b'"');
+    Ok(())
+}
+
+pub fn output(cmd: &mut Command) -> io::Result<(ExitStatus, Vec<u8>, Vec<u8>)> {
+    let (mut process, mut pipes) = cmd.spawn(Stdio::MakePipe, false)?;
+    drop(pipes.stdin.take());
+    let status = process.wait()?;
+    let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+    if let Some(out) = pipes.stdout.take() {
+        out.read_to_end(&mut stdout)?;
+    }
+    if let Some(err) = pipes.stderr.take() {
+        err.read_to_end(&mut stderr)?;
+    }
+    Ok((status, stdout, stderr))
+}
+
+impl From<ChildPipe> for Stdio {
+    fn from(pipe: ChildPipe) -> Stdio {
+        match &pipe.kind {
+            PipeKind::Output { shared, file, .. } => Stdio::Captured(shared.clone(), file.clone()),
+            // The input of another child: nothing to read from it.
+            PipeKind::Input { .. } => Stdio::Null,
+        }
+    }
+}
+
+/// The pipe of `io::pipe()`, which AROS does not have, so there is no value of it.
+impl From<crate::sys::pipe::Pipe> for Stdio {
+    fn from(pipe: crate::sys::pipe::Pipe) -> Stdio {
+        pipe.diverge()
+    }
+}
+
+impl From<io::Stdout> for Stdio {
+    fn from(_: io::Stdout) -> Stdio {
+        Stdio::ParentStdout
+    }
+}
+
+impl From<io::Stderr> for Stdio {
+    fn from(_: io::Stderr) -> Stdio {
+        Stdio::ParentStderr
+    }
+}
+
+impl From<File> for Stdio {
+    fn from(file: File) -> Stdio {
+        Stdio::InheritFile(file)
+    }
+}
