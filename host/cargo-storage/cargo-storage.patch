+        use std::os::unix::ffi::OsStringExt;
+        let fixture = Fixture::new();
+        let path = fixture
+            .0
+            .join(std::ffi::OsString::from_vec(b"cache-\xff".to_vec()));
+        fs::create_dir(&path).unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o700)).unwrap();
+        assert_eq!(validate_storage_root(&path, fixture.uid()).unwrap(), path);
+    }
+    #[test]
+    fn expands_literal_paths_without_requiring_text_conversion() {
+        use std::os::unix::ffi::{OsStrExt, OsStringExt};
+        let root = OsString::from_vec(b"/cache-\xff with spaces/{literal}".to_vec());
+        let values = [
+            ("{cargo-cache-home}", root.clone()),
+            ("{workspace-path-hash}", OsString::from("ab/cd")),
+        ];
+        let path =
+            expand_checked_os_template("{cargo-cache-home}/build/{workspace-path-hash}", &values);
+        assert_eq!(
+            path.as_bytes(),
+            b"/cache-\xff with spaces/{literal}/build/ab/cd"
+        );
+        assert_eq!(
+            expand_checked_os_template("ordinary/build", &values),
+            OsStr::new("ordinary/build")
+        );
+    }
+
+    #[test]
+    fn substitutes_repeated_keys_and_keeps_replacement_values_literal() {
+        let values = [
+            ("{root}", OsString::from("/cache/{hash}")),
+            ("{hash}", OsString::from("ab")),
+        ];
+        assert_eq!(
+            expand_checked_os_template("{root}/{hash}/{root}", &values),
+            OsStr::new("/cache/{hash}/ab//cache/{hash}")
+        );
+    }
+
+    #[test]
+    fn preserves_empty_and_keyless_templates() {
+        let values = [("{root}", OsString::from("/cache"))];
+        assert_eq!(expand_checked_os_template("", &values), OsStr::new(""));
+        assert_eq!(
+            expand_checked_os_template("relative path/Ω", &values),
+            OsStr::new("relative path/Ω")
+        );
+    }
