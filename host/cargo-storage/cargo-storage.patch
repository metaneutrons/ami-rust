+//! Validation for the downstream explicit Cargo cache-storage selector.
+//!
+//! This validates a local writable-store location, not an authenticated SDK.
+//! Configuration and credential paths continue to use the original Cargo home.
+
+use std::ffi::{OsStr, OsString};
+use std::io;
+use std::path::{Path, PathBuf};
+
+/// Expand already-validated template keys without converting OS paths to text.
+/// Replacement values are literal and are never scanned as template syntax.
+pub(super) fn expand_checked_os_template(
+    mut template: &str,
+    replacements: &[(&str, OsString)],
+) -> OsString {
+    let mut result = OsString::new();
+    loop {
+        let next = replacements
+            .iter()
+            .filter_map(|(key, value)| template.find(key).map(|index| (index, *key, value)))
+            .min_by_key(|(index, _, _)| *index);
+        let Some((index, key, value)) = next else {
+            result.push(OsStr::new(template));
+            return result;
+        };
+        result.push(OsStr::new(&template[..index]));
+        result.push(value);
+        template = &template[index + key.len()..];
+    }
+}
+
+#[cfg(unix)]
+pub(super) fn validate_storage_root(root: &Path, effective_uid: u32) -> io::Result<PathBuf> {
+    use std::os::unix::fs::MetadataExt;
+
+    if root.as_os_str().is_empty() || !root.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "storage root must be a nonempty absolute path",
+        ));
+    }
+    let canonical = root.canonicalize()?;
+    if canonical.as_os_str() != root.as_os_str() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "storage root must use its canonical path without symlink aliases",
+        ));
+    }
+    let metadata = std::fs::symlink_metadata(&canonical)?;
+    if !metadata.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::NotADirectory,
+            "storage root must be an existing directory",
+        ));
+    }
+    if metadata.uid() != effective_uid || metadata.mode() & 0o022 != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "storage root must be owned by the effective user and not writable by group or others",
+        ));
+    }
+    Ok(canonical)
+}
