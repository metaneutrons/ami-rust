+            fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+            Self(root)
+        }
+
+        fn cache(&self) -> PathBuf {
+            let path = self.0.join("cache with spaces and Ω");
+            fs::create_dir(&path).unwrap();
+            fs::set_permissions(&path, fs::Permissions::from_mode(0o755)).unwrap();
+            path
+        }
+
+        fn uid(&self) -> u32 {
+            fs::metadata(&self.0).unwrap().uid()
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).expect("remove owned storage fixture");
+        }
+    }
+
+    #[test]
+    fn accepts_owned_readable_cache_without_requiring_private_read_bits() {
+        let fixture = Fixture::new();
+        let cache = fixture.cache();
+        assert_eq!(validate_storage_root(&cache, fixture.uid()).unwrap(), cache);
+    }
+
+    #[test]
+    fn refuses_empty_and_relative_paths_without_creating_them() {
+        for path in ["", "relative-cache", "../cache"] {
+            assert_eq!(
+                validate_storage_root(Path::new(path), 0)
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::InvalidInput,
+            );
+        }
+    }
+
+    #[test]
+    fn refuses_missing_root_and_regular_file() {
+        let fixture = Fixture::new();
+        let missing = fixture.0.join("missing");
+        assert_eq!(
+            validate_storage_root(&missing, fixture.uid())
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::NotFound,
+        );
+        assert!(!missing.exists());
+        let file = fixture.0.join("file");
+        fs::write(&file, b"not a directory").unwrap();
+        assert_eq!(
+            validate_storage_root(&file, fixture.uid())
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::NotADirectory,
+        );
+    }
+
+    #[test]
+    fn refuses_wrong_owner_and_group_or_other_writable_roots() {
+        let fixture = Fixture::new();
+        let cache = fixture.cache();
+        assert!(validate_storage_root(&cache, fixture.uid()).is_ok());
+        assert_eq!(
+            validate_storage_root(&cache, fixture.uid().wrapping_add(1))
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::PermissionDenied,
+        );
+        for mode in [0o775, 0o757, 0o777] {
+            fs::set_permissions(&cache, fs::Permissions::from_mode(mode)).unwrap();
+            assert_eq!(
+                validate_storage_root(&cache, fixture.uid())
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::PermissionDenied,
+            );
+        }
+    }
+
+    #[test]
+    fn refuses_symlink_and_noncanonical_spelling() {
+        let fixture = Fixture::new();
+        let cache = fixture.cache();
+        let alias = fixture.0.join("alias");
+        symlink(&cache, &alias).unwrap();
+        assert_eq!(
+            validate_storage_root(&alias, fixture.uid())
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput,
+        );
+        let spelled = PathBuf::from(format!("{}/.", cache.display()));
+        assert_eq!(
+            validate_storage_root(&spelled, fixture.uid())
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput,
+        );
+        assert!(validate_storage_root(&cache, fixture.uid()).is_ok());
+    }
+
