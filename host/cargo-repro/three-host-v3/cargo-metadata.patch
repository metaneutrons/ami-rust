+/// Project a host tool's reachable unit identities into target symbols, while
+/// keeping its actual native metadata and dependency graph in the cache key.
+/// Redundant host cfg edges may differ across hosts without changing this set.
+/// Different reachable packages, features, profiles or roles remain different.
+fn host_tool_projection(
+    root: &Unit,
+    build_runner: &BuildRunner<'_, '_>,
+    metas: &mut HashMap<Unit, Metadata>,
+) -> UnitHash {
+    // Distinct Cargo units can have the same local descriptor but different
+    // dependency contexts (Unit::dep_hash). Never normalize such simultaneous
+    // variants into one target namespace. Scan the invocation, not just one
+    // closure, so separately consumed host roots are covered too.
+    let mut by_descriptor = HashMap::<UnitHash, &Unit>::default();
+    let mut ambiguous = std::collections::HashSet::new();
+    for unit in build_runner
+        .bcx
+        .unit_graph
+        .keys()
+        .filter(|u| u.kind.is_host())
+    {
+        let descriptor = UnitHash(Hasher::finish(&host_tool_seed(unit, build_runner)));
+        if let Some(previous) = by_descriptor.insert(descriptor, unit) {
+            if previous != unit {
+                ambiguous.insert(descriptor);
+            }
+        }
+    }
+    let root_descriptor = UnitHash(Hasher::finish(&host_tool_seed(root, build_runner)));
+    let mut pending = vec![root.clone()];
+    let mut visited = std::collections::HashSet::new();
+    let mut identities = std::collections::BTreeSet::new();
+    while let Some(unit) = pending.pop() {
+        if !visited.insert(unit.clone()) {
+            continue;
+        }
+        if !unit.kind.is_host() {
+            // Cross-built artifact dependencies are not host implementation
+            // details: retain their actual target metadata as an opaque leaf.
+            identities.insert((1_u8, metadata_of(&unit, build_runner, metas).c_metadata));
+            continue;
+        }
+        let descriptor = UnitHash(Hasher::finish(&host_tool_seed(&unit, build_runner)));
+        if ambiguous.contains(&descriptor) {
+            // Preserve the upstream distinction, accepting an observable
+            // cross-host mismatch instead of merging distinct crate instances.
+            let mut fallback = StableHasher::new();
+            "ami-rust-native-host-fallback-v3".hash(&mut fallback);
+            metadata_of(root, build_runner, metas)
+                .c_metadata
+                .hash(&mut fallback);
+            return UnitHash(Hasher::finish(&fallback));
+        }
+        identities.insert((0_u8, descriptor));
+        pending.extend(
+            build_runner
+                .unit_deps(&unit)
+                .iter()
+                .map(|dep| dep.unit.clone()),
+        );
+    }
+    let mut hasher = StableHasher::new();
+    "ami-rust-host-tool-closure-v3".hash(&mut hasher);
+    root_descriptor.hash(&mut hasher);
+    identities.hash(&mut hasher);
+    UnitHash(Hasher::finish(&hasher))
+}
