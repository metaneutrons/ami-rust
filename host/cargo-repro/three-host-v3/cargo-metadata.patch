+/// Unit-local host descriptor; dependency context is checked separately above.
+fn host_tool_seed(unit: &Unit, build_runner: &BuildRunner<'_, '_>) -> StableHasher {
+    let mut seed = metadata_seed(unit, build_runner, true);
+    unit.artifact.hash(&mut seed);
+    unit.artifact_target_for_features
+        .map(|target| target.fingerprint_hash())
+        .hash(&mut seed);
+    unit.skip_non_compile_time_dep.hash(&mut seed);
+    seed
 }
 
