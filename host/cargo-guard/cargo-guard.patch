+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn origins_do_not_collapse_cli_file_or_different_files() {
+        assert_ne!(
+            origin(&Definition::Path("/a/config".into())).unwrap(),
+            origin(&Definition::Path("/b/config".into())).unwrap()
+        );
+        assert_ne!(
+            origin(&Definition::Path("/a/config".into())).unwrap(),
+            origin(&Definition::Cli(Some("/a/config".into()))).unwrap()
+        );
+    }
+
+    #[test]
+    fn configuration_tree_preserves_each_array_item_origin_and_bounds() {
+        let list = CV::List(
+            vec![
+                CV::String("one".into(), Definition::Path("/a/config".into())),
+                CV::String("two".into(), Definition::Cli(None)),
+            ],
+            Definition::BuiltIn,
+        );
+        let record = config_tree(&list, &mut 3, 0).unwrap();
+        assert_eq!(record["value"][0]["origin"]["kind"], "path");
+        assert_eq!(record["value"][1]["origin"]["kind"], "cli");
+        assert!(config_tree(&list, &mut 2, 0).is_err());
+    }
+
+    #[test]
+    fn selector_absent_keeps_guard_inactive_and_does_not_touch_config() {
+        let mut context =
+            GlobalContext::new(crate::Shell::new(), "/".into(), "/nonexistent-home".into());
+        context.set_env(Default::default());
+        assert!(!context.ami_guard_is_requested());
+        context.configure_ami_guard(&None).unwrap();
+        assert!(context.values.get().is_none());
+    }
+
+    #[test]
+    fn partial_selection_and_populated_caches_refuse() {
+        let mut context =
+            GlobalContext::new(crate::Shell::new(), "/".into(), "/nonexistent-home".into());
+        context.set_env(
+            [(CALLBACK.to_owned(), "/missing-callback".to_owned())]
+                .into_iter()
+                .collect(),
+        );
+        assert!(context.ami_guard_is_requested());
+        assert!(context.configure_ami_guard(&None).is_err());
+        assert!(context.check_ami_guard_command("install").is_err());
+        assert!(context.check_ami_guard_command("metadata").is_ok());
+        context
+            .net_config
+            .set(super::super::CargoNetConfig {
+                retry: None,
+                offline: None,
+                git_fetch_with_cli: None,
+                ssh: None,
+            })
+            .unwrap();
+        assert!(context.ami_guard_caches_empty().is_err());
+    }
+}
