+fn source_definitions(
+    gctx: &GlobalContext,
+) -> CargoResult<Option<HashMap<String, SourceConfigDef>>> {
+    Ok(gctx.get("source")?)
+}
+
+fn source_path_to_string(path: &Path) -> CargoResult<String> {
+    path.to_str()
+        .map(str::to_owned)
+        .ok_or_else(|| anyhow::anyhow!("source configuration path is not valid UTF-8"))
+}
+
+fn definition_json(definition: &Definition) -> CargoResult<JsonValue> {
+    Ok(match definition {
+        Definition::BuiltIn => json!({"kind": "built-in"}),
+        Definition::Path(path) => json!({
+            "kind": "path",
+            "path": source_path_to_string(path)?,
+        }),
+        Definition::Environment(name) => json!({
+            "kind": "environment",
+            "name": name,
+        }),
+        Definition::Cli(None) => json!({"kind": "cli"}),
+        Definition::Cli(Some(path)) => json!({
+            "kind": "cli-file",
+            "path": source_path_to_string(path)?,
+        }),
+    })
+}
+
+fn scalar_definition_json(value: &context::Value<String>) -> CargoResult<JsonValue> {
+    Ok(json!({
+        "value": value.val.as_str(),
+        "origin": definition_json(&value.definition)?,
+    }))
+}
+
+fn path_definition_json(path: &ConfigRelativePath, gctx: &GlobalContext) -> CargoResult<JsonValue> {
+    Ok(json!({
+        "value": path.raw_value(),
+        "origin": definition_json(&path.value().definition)?,
+        "resolved-path": source_path_to_string(&path.resolve_path(gctx))?,
+    }))
+}
+
+fn insert_scalar_definition(
+    fields: &mut serde_json::Map<String, JsonValue>,
+    key: &str,
+    value: &OptValue<String>,
+) -> CargoResult<()> {
+    if let Some(value) = value {
+        fields.insert(key.to_owned(), scalar_definition_json(value)?);
+    }
+    Ok(())
+}
+
+fn insert_path_definition(
+    fields: &mut serde_json::Map<String, JsonValue>,
+    key: &str,
+    value: &Option<ConfigRelativePath>,
+    gctx: &GlobalContext,
+) -> CargoResult<()> {
+    if let Some(value) = value {
+        fields.insert(key.to_owned(), path_definition_json(value, gctx)?);
+    }
+    Ok(())
+}
+
+/// Returns source configuration definitions without constructing source IDs.
+pub(crate) fn ami_rust_source_definitions(gctx: &GlobalContext) -> CargoResult<JsonValue> {
+    let Some(sources) = source_definitions(gctx)? else {
+        return Ok(json!({}));
+    };
+
+    let mut sources: Vec<_> = sources.into_iter().collect();
+    sources.sort_unstable_by(|left, right| left.0.cmp(&right.0));
+
+    let mut result = serde_json::Map::new();
+    for (name, definition) in sources {
+        let mut fields = serde_json::Map::new();
+        insert_scalar_definition(&mut fields, "replace-with", &definition.replace_with)?;
+        insert_path_definition(&mut fields, "directory", &definition.directory, gctx)?;
+        insert_scalar_definition(&mut fields, "registry", &definition.registry)?;
+        insert_path_definition(
+            &mut fields,
+            "local-registry",
+            &definition.local_registry,
+            gctx,
+        )?;
+        insert_scalar_definition(&mut fields, "git", &definition.git)?;
+        insert_scalar_definition(&mut fields, "branch", &definition.branch)?;
+        insert_scalar_definition(&mut fields, "tag", &definition.tag)?;
+        insert_scalar_definition(&mut fields, "rev", &definition.rev)?;
+        result.insert(name, JsonValue::Object(fields));
+    }
+
+    Ok(JsonValue::Object(result))
+}
