diff --git a/src/context/ami_guard.rs b/src/context/ami_guard.rs
new file mode 100644
--- /dev/null
+++ b/src/context/ami_guard.rs
@@ -0,0 +1,596 @@
+//! Downstream Cargo-owned input validation before activation configuration wins.
+//!
+//! These selectors are private launcher plumbing, not publisher authentication.
+//! The selected native role must authenticate its activation and this engine.
+//! No configuration record is written to disk or printed as diagnostics.
+
+use super::{CV, OptValue, StringList};
+use super::{ConfigKey, ConfigRelativePath, ConfigValue, Definition, EnvConfig, GlobalContext};
+use crate::CargoResult;
+use crate::util::command_prelude::ArgMatchesExt;
+use anyhow::{Context as _, bail};
+use serde::Deserialize;
+use serde_json::{Map, Value as Json, json};
+use std::ffi::OsStr;
+use std::io::{ErrorKind, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+const CALLBACK: &str = "AMI_RUST_CARGO_GUARD";
+const OVERLAY: &str = "AMI_RUST_CARGO_OVERLAY";
+const MAX_RECORD_BYTES: usize = 1024 * 1024;
+const CALLBACK_SECONDS: u64 = 30;
+
+impl GlobalContext {
+    /// Any partial private request must fail closed, including informational CLI branches.
+    pub fn ami_guard_is_requested(&self) -> bool {
+        self.get_env_os(CALLBACK).is_some() || self.get_env_os(OVERLAY).is_some()
+    }
+
+    /// Check the documented selected route before external subcommand lookup.
+    pub fn check_ami_guard_command(&self, command: &str) -> CargoResult<()> {
+        if self.ami_guard_is_requested() && !matches!(command, "metadata" | "check" | "build") {
+            bail!("unsupported command in the selected ami-rust Cargo route");
+        }
+        Ok(())
+    }
+
+    fn ami_guard_paths(&self) -> CargoResult<(PathBuf, PathBuf)> {
+        let callback = self
+            .get_env_os(CALLBACK)
+            .context("missing ami-rust Cargo guard selector")?;
+        let overlay = self
+            .get_env_os(OVERLAY)
+            .context("missing ami-rust Cargo overlay selector")?;
+        let callback = checked_file(Path::new(callback), true)?;
+        let overlay = checked_file(Path::new(overlay), false)?;
+        if self.get_env_os("CARGO_CACHE_RUSTC_INFO") != Some(OsStr::new("0")) {
+            bail!("selected ami-rust Cargo requires compiler-info disk caching disabled");
+        }
+        Ok((callback, overlay))
+    }
+
+    fn ami_guard_caches_empty(&self) -> CargoResult<()> {
+        if self.net_config.get().is_some()
+            || self.build_config.get().is_some()
+            || self.target_cfgs.get().is_some()
+            || self.env_config.get().is_some()
+            || self.http_config.get().is_some()
+            || self.http_async.get().is_some()
+            || self.rustdoc.get().is_some()
+            || self.global_cache_tracker.get().is_some()
+            || self.deferred_global_last_use.get().is_some()
+        {
+            bail!("ami-rust Cargo configuration guard reached after derived configuration use");
+        }
+        Ok(())
+    }
+
+    pub(super) fn configure_ami_guard(&mut self, target_dir: &Option<PathBuf>) -> CargoResult<()> {
+        if !self.ami_guard_is_requested() {
+            return Ok(());
+        }
+        let (callback, overlay) = self.ami_guard_paths()?;
+        if self.cli_unstable().script {
+            bail!("Cargo script mode is outside the selected ami-rust command surface");
+        }
+        self.ami_guard_caches_empty()?;
+        // Direct typed getters only: the generated overlay has not been merged yet.
+        let mut record = self.ami_guard_configuration("configuration")?;
+        record["cli_target_dir"] = optional_path(target_dir.as_deref())?;
+        record["overlay"] = json!(path_text(&overlay)?);
+        self.ami_guard_overlay_not_loaded(&overlay)?;
+        validate_callback(&callback, &record)?;
+        self.ami_guard_caches_empty()?;
+        let entry = path_text(&overlay)?.to_owned();
+        let additions = self
+            .cli_config_slice_as_table(std::slice::from_ref(&entry), super::WhyLoad::AmiOverlay)?;
+        self.merge_cli_table(additions)?;
+        self.cli_config.get_or_insert_default().push(entry);
+        self.load_unstable_flags_from_config()?;
+        self.check_ami_storage_environment()?;
+        // The callback cannot authorize a lifecycle that initialized stale typed caches.
+        self.ami_guard_caches_empty()?;
+        Ok(())
+    }
+
+    fn ami_guard_overlay_not_loaded(&self, overlay: &Path) -> CargoResult<()> {
+        let parsed = self.ami_loaded_config_paths.lock().unwrap();
+        #[cfg(unix)]
+        let overlay_identity = {
+            use std::os::unix::fs::MetadataExt;
+            let metadata = std::fs::metadata(overlay)?;
+            (metadata.dev(), metadata.ino())
+        };
+        for path in parsed.iter() {
+            let mut matches = path == overlay;
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::MetadataExt;
+                let metadata = std::fs::metadata(path)
+                    .context("cannot recheck parsed Cargo configuration identity")?;
+                matches |= (metadata.dev(), metadata.ino()) == overlay_identity;
+            }
+            if matches {
+                bail!("generated ami-rust overlay already loaded through user configuration");
+            }
+        }
+        Ok(())
+    }
+
+    /// Runs even for metadata --no-deps and cache-hit commands, before source/layout work.
+    pub fn validate_ami_guard_command(
+        &self,
+        command: &str,
+        args: &clap::ArgMatches,
+    ) -> CargoResult<()> {
+        if !self.ami_guard_is_requested() {
+            return Ok(());
+        }
+        self.check_ami_guard_command(command)?;
+        let (callback, _) = self.ami_guard_paths()?;
+        let mut record = self.ami_guard_configuration("command")?;
+        record["command"] = json!(command);
+        let mut options = Map::new();
+        for key in [
+            "manifest-path",
+            "target-dir",
+            "artifact-dir",
+            "target",
+            "filter-platform",
+            "package",
+            "exclude",
+            "features",
+            "bin",
+            "example",
+            "test",
+            "bench",
+            "profile",
+            "message-format",
+        ] {
+            if let Ok(Some(values)) = args.try_get_many::<String>(key) {
+                options.insert(key.to_owned(), json!(values.collect::<Vec<_>>()));
+            }
+            if let Ok(Some(values)) = args.try_get_many::<PathBuf>(key) {
+                let paths = values
+                    .map(|path| path_text(path))
+                    .collect::<CargoResult<Vec<_>>>()?;
+                options.insert(key.to_owned(), json!(paths));
+            }
+        }
+        for key in [
+            "workspace",
+            "lib",
+            "bins",
+            "examples",
+            "tests",
+            "benches",
+            "unit-graph",
+            "all-features",
+            "no-default-features",
+            "release",
+            "all-targets",
+            "no-deps",
+            "locked",
+            "offline",
+            "frozen",
+        ] {
+            if let Ok(Some(value)) = args.try_get_one::<bool>(key) {
+                options.insert(key.to_owned(), json!(value));
+            }
+        }
+        record["options"] = Json::Object(options);
+        // Cargo's manifest/workspace resolver owns these paths. This performs no
+        // dependency resolution, compiler query, package-cache lock or Layout creation.
+        let workspace = args.workspace(self)?;
+        record["workspace"] = json!({
+            "manifest": path_text(workspace.root_manifest())?,
+            "root": path_text(workspace.root())?,
+            "target_dir": path_text(workspace.target_dir().as_path_unlocked())?,
+            "build_dir": path_text(workspace.build_dir().as_path_unlocked())?,
+        });
+        validate_callback(&callback, &record)
+    }
+
+    fn ami_guard_configuration(&self, phase: &str) -> CargoResult<Json> {
+        let mut config = Map::new();
+        for key in [
+            "rustc",
+            "rustc-wrapper",
+            "rustc-workspace-wrapper",
+            "rustdoc",
+            "target-dir",
+            "build-dir",
+            "artifact-dir",
+        ] {
+            let value: Option<ConfigRelativePath> = self.get(&format!("build.{key}"))?;
+            if let Some(value) = value {
+                let resolved = if matches!(
+                    key,
+                    "rustc" | "rustc-wrapper" | "rustc-workspace-wrapper" | "rustdoc"
+                ) {
+                    value.resolve_program(self)
+                } else {
+                    value.resolve_path(self)
+                };
+                config.insert(
+                    format!("build.{key}"),
+                    json!({
+                        "value": value.raw_value(), "resolved": path_text(&resolved)?,
+                        "origin": origin(&value.value().definition)?,
+                    }),
+                );
+            }
+        }
+        for key in ["build.target", "build.rustflags", "build.rustdocflags"] {
+            let value: OptValue<StringList> = self.get(key)?;
+            if let Some(value) = value {
+                config.insert(
+                    key.to_owned(),
+                    json!({"value":value.val.as_slice(),"origin":origin(&value.definition)?}),
+                );
+            }
+        }
+        // Keep the complete origin-bearing target/host/unstable control subtrees.
+        // Later target/cfg fixed-point and actual compiler-role validation remain required.
+        let mut nodes = 16384;
+        let mut origins = Map::new();
+        if let Some(CV::Table(build, _)) = self.values()?.get("build") {
+            for key in [
+                "rustc",
+                "rustc-wrapper",
+                "rustc-workspace-wrapper",
+                "rustdoc",
+                "target",
+                "rustflags",
+                "rustdocflags",
+                "target-dir",
+                "build-dir",
+                "artifact-dir",
+            ] {
+                if let Some(value) = build.get(key) {
+                    origins.insert(format!("build.{key}"), config_tree(value, &mut nodes, 0)?);
+                }
+            }
+        }
+        for key in ["target", "host", "unstable", "target-applies-to-host"] {
+            if let Some(value) = self.values()?.get(key) {
+                config.insert(key.to_owned(), config_tree(value, &mut nodes, 0)?);
+            }
+        }
+        // Typed getters apply Cargo's environment precedence without filling derived caches.
+        // A ConfigKey is built segment-by-segment so cfg keys containing dots stay literal.
+        let mut typed_targets = Map::new();
+        for table in ["target", "host"] {
+            if let Some(CV::Table(entries, _)) = self.values()?.get(table) {
+                for name in entries.keys() {
+                    for field in ["linker", "rustflags", "rustdocflags"] {
+                        let mut key = ConfigKey::new();
+                        key.push(table);
+                        key.push(name);
+                        key.push(field);
+                        let snapshot = if field == "linker" {
+                            let value: OptValue<ConfigRelativePath> =
+                                self.ami_guard_get(key.clone())?;
+                            value.map(|v| Ok::<_, anyhow::Error>(json!({"value":v.val.raw_value(),
+                                "resolved":path_text(&v.val.resolve_program(self))?,"origin":origin(&v.definition)?}))).transpose()?
+                        } else {
+                            let value: OptValue<StringList> = self.ami_guard_get(key.clone())?;
+                            value.map(|v| Ok::<_, anyhow::Error>(json!({"value":v.val.as_slice(),"origin":origin(&v.definition)?}))).transpose()?
+                        };
+                        if let Some(value) = snapshot {
+                            typed_targets.insert(key.to_string(), value);
+                        }
+                    }
+                }
+            }
+        }
+        let mut environment = Map::new();
+        for key in self
+            .env
+            .keys_str()
+            .filter(|key| control_environment_key(key))
+        {
+            let value = self
+                .get_env_os(key)
+                .context("missing selected environment value")?;
+            let text = value
+                .to_str()
+                .context("ami-rust compiler control environment is not UTF-8")?;
+            environment.insert(key.to_owned(), json!(text));
+        }
+        let env_config: EnvConfig = self.get("env")?;
+        let mut child_environment = Map::new();
+        for (key, value) in env_config
+            .iter()
+            .filter(|(key, _)| control_environment_key(key))
+        {
+            let value_text = value.resolve(self.cwd());
+            child_environment.insert(key.clone(), json!({
+                "value": value_text.to_str().context("ami-rust configured child control is not UTF-8")?,
+                "force": value.is_force(),
+            }));
+        }
+        Ok(json!({
+            "schema":"ami-rust-cargo-inputs-v1", "phase":phase,
+            "cwd":path_text(self.cwd())?, "cargo_home":path_text(self.home_path.as_path_unlocked())?,
+            "configuration":config, "configuration_origins":origins, "target_configuration":typed_targets,
+            "unstable_cli":self.unstable_flags_cli,
+            "environment":environment, "child_environment":child_environment,
+            "sources":crate::sources::config::ami_rust_source_definitions(self)?,
+        }))
+    }
+
+    fn ami_guard_get<'de, T: Deserialize<'de>>(&self, key: ConfigKey) -> CargoResult<T> {
+        T::deserialize(super::de::Deserializer {
+            gctx: self,
+            key,
+            env_prefix_ok: true,
+        })
+        .map_err(Into::into)
+    }
+}
+
+fn control_environment_key(key: &str) -> bool {
+    matches!(
+        key,
+        "RUSTC"
+            | "RUSTC_WRAPPER"
+            | "RUSTC_WORKSPACE_WRAPPER"
+            | "RUSTDOC"
+            | "RUSTFLAGS"
+            | "RUSTDOCFLAGS"
+            | "CARGO_ENCODED_RUSTFLAGS"
+            | "CARGO_ENCODED_RUSTDOCFLAGS"
+            | "CARGO_TARGET_DIR"
+            | "CARGO_CACHE_RUSTC_INFO"
+            | "RUSTUP_HOME"
+            | "RUSTUP_TOOLCHAIN"
+            | "PATH"
+            | "AMI_RUST_BUILD_HELPER"
+            | "AMI_RUST_BUILD_INVOCATION"
+            | "AMI_RUST_CARGO_STORAGE_ROOT"
+            | CALLBACK
+            | OVERLAY
+    ) || key.starts_with("CARGO_BUILD_")
+        || key.starts_with("CARGO_UNSTABLE_")
+        || (key.starts_with("CARGO_TARGET_")
+            && (key.ends_with("_LINKER")
+                || key.ends_with("_RUSTFLAGS")
+                || key.ends_with("_RUSTDOCFLAGS")))
+}
+
+fn path_text(path: &Path) -> CargoResult<&str> {
+    path.to_str()
+        .context("ami-rust compiler-bound path is not UTF-8")
+}
+
+fn optional_path(path: Option<&Path>) -> CargoResult<Json> {
+    path.map(path_text).transpose().map(|path| json!(path))
+}
+
+fn origin(definition: &Definition) -> CargoResult<Json> {
+    Ok(match definition {
+        Definition::BuiltIn => json!({"kind":"built-in"}),
+        Definition::Path(path) => json!({"kind":"path","path":path_text(path)?}),
+        Definition::Environment(name) => json!({"kind":"environment","name":name}),
+        Definition::Cli(None) => json!({"kind":"cli"}),
+        Definition::Cli(Some(path)) => json!({"kind":"cli-file","path":path_text(path)?}),
+    })
+}
+
+fn config_tree(value: &ConfigValue, remaining: &mut usize, depth: usize) -> CargoResult<Json> {
+    if *remaining == 0 || depth > 32 {
+        bail!("ami-rust build-control record exceeds structural bound");
+    }
+    *remaining -= 1;
+    let (value, def) = match value {
+        CV::String(value, def) => (json!(value), def),
+        CV::Integer(value, def) => (json!(value), def),
+        CV::Boolean(value, def) => (json!(value), def),
+        CV::List(values, def) => (
+            Json::Array(
+                values
+                    .iter()
+                    .map(|v| config_tree(v, remaining, depth + 1))
+                    .collect::<CargoResult<_>>()?,
+            ),
+            def,
+        ),
+        CV::Table(values, def) => {
+            let mut output = Map::new();
+            for (key, value) in values {
+                output.insert(key.clone(), config_tree(value, remaining, depth + 1)?);
+            }
+            (Json::Object(output), def)
+        }
+    };
+    Ok(json!({"value":value,"origin":origin(def)?}))
+}
+
+fn checked_file(path: &Path, executable: bool) -> CargoResult<PathBuf> {
+    if !path.is_absolute() || path.as_os_str().is_empty() {
+        bail!("ami-rust guard inputs require absolute local paths");
+    }
+    let canonical = path
+        .canonicalize()
+        .context("cannot resolve ami-rust guard input")?;
+    if canonical.as_os_str() != path.as_os_str() {
+        bail!("ami-rust guard input uses a noncanonical path");
+    }
+    let metadata =
+        std::fs::symlink_metadata(path).context("cannot inspect ami-rust guard input")?;
+    if !metadata.is_file() {
+        bail!("ami-rust guard input is not a regular file");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        let uid = unsafe { libc::geteuid() };
+        if metadata.uid() != uid
+            || metadata.mode() & 0o022 != 0
+            || (executable && metadata.mode() & 0o111 == 0)
+        {
+            bail!("ami-rust guard input ownership or permissions are invalid");
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = executable;
+        bail!("ami-rust selected Cargo guard requires a supported Unix host");
+    }
+    Ok(canonical)
+}
+
+fn validate_callback(callback: &Path, record: &Json) -> CargoResult<()> {
+    let raw = serde_json::to_vec(record)?;
+    if raw.len() > MAX_RECORD_BYTES {
+        bail!("ami-rust Cargo input record exceeds byte bound");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::fd::AsRawFd;
+        let mut child = Command::new(callback)
+            .arg("--ami-rust-cargo-guard-v1")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .context("cannot start selected ami-rust Cargo validation role")?;
+        let result = (|| {
+            let mut stdin = child
+                .stdin
+                .take()
+                .context("missing Cargo guard input pipe")?;
+            let fd = stdin.as_raw_fd();
+            let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+            if flags < 0 || unsafe { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0
+            {
+                bail!("cannot bound selected Cargo guard input pipe");
+            }
+            let start = Instant::now();
+            let mut offset = 0;
+            loop {
+                if start.elapsed() >= Duration::from_secs(CALLBACK_SECONDS) {
+                    bail!("selected Cargo validation role timed out");
+                }
+                if let Some(status) = child.try_wait()? {
+                    if offset != raw.len() || !status.success() {
+                        bail!("selected Cargo validation role refused inputs");
+                    }
+                    return Ok(());
+                }
+                if offset < raw.len() {
+                    match stdin.write(&raw[offset..]) {
+                        Ok(0) => bail!("selected Cargo validation role closed its input"),
+                        Ok(count) => offset += count,
+                        Err(error)
+                            if matches!(
+                                error.kind(),
+                                ErrorKind::WouldBlock | ErrorKind::Interrupted
+                            ) =>
+                        {
+                            ()
+                        }
+                        Err(_) => bail!("cannot deliver selected Cargo validation inputs"),
+                    }
+                }
+                if offset == raw.len() {
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            drop(stdin);
+            loop {
+                if let Some(status) = child.try_wait()? {
+                    if !status.success() {
+                        bail!("selected Cargo validation role refused inputs");
+                    }
+                    return Ok(());
+                }
+                if start.elapsed() >= Duration::from_secs(CALLBACK_SECONDS) {
+                    bail!("selected Cargo validation role timed out");
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+        })();
+        if result.is_err() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+        result
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = (callback, raw);
+        bail!("unsupported selected Cargo guard host");
+    }
+}
